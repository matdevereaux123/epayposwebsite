---
// The signature element. A hairline rule that carries a settlement-style
// readout and counts up once on entry — then settles, like a batch closing.
// Reused as the divider between major sections, so it becomes the spine
// of the page while doing real work as social proof.
//
// Numbers passed in must be real. Do not invent figures for this component.

interface Readout {
  label: string;
  value: string | number;
  prefix?: string;
  suffix?: string;
}

interface Props {
  readouts?: Readout[];
  /** Plain divider with no readout — for use between lesser sections. */
  bare?: boolean;
}

const { readouts = [], bare = false } = Astro.props;
---

<div class={`bl ${bare ? "bl--bare" : ""}`}>
  <div class="bl__rule"><span class="bl__dot"></span></div>
  {!bare && readouts.length > 0 && (
    <div class="bl__readouts wrap">
      {readouts.map((r) => (
        <div class="bl__readout">
          <span class="bl__label">{r.label}</span>
          <span
            class="bl__value stat"
            data-count={typeof r.value === "number" ? r.value : undefined}
            data-prefix={r.prefix ?? ""}
            data-suffix={r.suffix ?? ""}
          >
            {r.prefix ?? ""}{typeof r.value === "number" ? r.value.toLocaleString("en-US") : r.value}{r.suffix ?? ""}
          </span>
        </div>
      ))}
    </div>
  )}
</div>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduce) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = Number(el.dataset.count);
        if (!Number.isFinite(target)) return io.unobserve(el);
        const prefix = el.dataset.prefix ?? "";
        const suffix = el.dataset.suffix ?? "";
        const start = performance.now();
        const dur = 900;
        const tick = (now: number) => {
          const p = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = prefix + Math.round(target * eased).toLocaleString("en-US") + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        io.unobserve(el);
      });
    }, { threshold: 0.6 });
    document.querySelectorAll("[data-count]").forEach((el) => io.observe(el));
  }
</script>

<style>
  .bl { position: relative; }

  .bl__rule {
    position: relative;
    height: 1px;
    background: var(--rule-strong);
  }

  .bl__dot {
    position: absolute;
    left: 18%;
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
    border-radius: 50%;
    background: var(--epay);
  }

  .bl__readouts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    padding-top: 1.25rem;
  }

  .bl__readout {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .bl__label {
    font-family: var(--font-data);
    font-size: var(--mono-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .bl__value {
    font-size: 1rem;
    font-weight: var(--weight-ui);
    color: var(--accent-deep);
  }

  .bl--bare .bl__readouts { display: none; }
</style>

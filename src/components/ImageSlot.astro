---
// One image position on the site.
//
// If the file exists under /public it renders as a real <img>. If not, the
// slot shows what belongs there and the exact path to drop it at, so the
// layout can be reviewed before any photography exists.
//
// Width and height are always set so the reserved space matches the final
// image and nothing shifts when the photo lands.

import fs from "node:fs";
import path from "node:path";

interface Props {
  /** What the picture should show. Becomes the alt text. */
  name: string;
  /** Public path, e.g. /img/industries/bar-lounge-hero.jpg */
  file: string;
  /** CSS aspect-ratio for the slot. */
  ratio?: string;
  /** Rendered width/height attributes, to reserve layout space. */
  width?: number;
  height?: number;
}

const { name, file, ratio = "4 / 3", width = 800, height = 600 } = Astro.props;

let exists = false;
try {
  exists = fs.existsSync(path.join(process.cwd(), "public", file.replace(/^\//, "")));
} catch {
  exists = false;
}
---

{exists ? (
  <img class="islot islot--live" src={file} alt={name} width={width} height={height} loading="lazy" style={`aspect-ratio:${ratio}`} />
) : (
  <span class="imgslot islot" style={`aspect-ratio:${ratio}`}>
    <span class="imgslot__icon" aria-hidden="true">+</span>
    <span class="imgslot__name">{name}</span>
    <span class="imgslot__path">{file}</span>
  </span>
)}

<style>
  .islot {
    width: 100%;
    height: auto;
  }

  .islot--live {
    display: block;
    object-fit: cover;
    border-radius: var(--radius);
  }
</style>

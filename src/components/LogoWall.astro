---
// Merchant logo strip — scrolls sideways without end, directly under the
// homepage banner.
//
// Each entry in content/logos.json is one logo. Once ANY logo file exists
// under /public, only real logos scroll; until then the placeholder slots
// scroll so the layout can be reviewed. Nothing here is invented — the
// placeholder names are obvious placeholders, not fake merchants.
//
// Motion is an owner-approved exception to design-system.md (2026-09-18).
// It pauses on hover, and holds still for visitors who ask their device to
// reduce motion.
//
// Do not put a real business name in logos.json without their permission.

import fs from "node:fs";
import path from "node:path";
import logoData from "../../content/logos.json";

const { eyebrow, logos, seconds_per_logo } = logoData as any;

const items = (logos as any[]).map((logo) => {
  const abs = path.join(process.cwd(), "public", logo.file.replace(/^\//, ""));
  let exists = false;
  try {
    exists = fs.existsSync(abs);
  } catch {
    exists = false;
  }
  return { ...logo, exists };
});

const real = items.filter((i) => i.exists);
const shown = real.length > 0 ? real : items;

// Repeat the set until one run is wide enough to fill a large screen, then
// render that run twice; sliding by exactly one run makes the loop seamless.
const MIN_PER_RUN = 10;
const repeats = Math.max(1, Math.ceil(MIN_PER_RUN / Math.max(shown.length, 1)));
const run = Array.from({ length: shown.length * repeats }, (_, i) => ({
  ...shown[i % shown.length],
  repeat: i >= shown.length,
}));
const duration = run.length * (seconds_per_logo ?? 3);
---

{shown.length > 0 && (
  <section class="lw" aria-label={eyebrow}>
    <p class="wrap mono-label lw__label">{eyebrow}</p>
    <div class="lw__viewport">
      <div class="lw__track" style={`--lw-duration:${duration}s`}>
        {[0, 1].map((copy) => (
          <ul class="lw__run" aria-hidden={copy === 1 ? "true" : undefined}>
            {run.map((logo) => (
              <li class={`lw__item ${logo.repeat ? "lw__item--repeat" : ""}`} aria-hidden={logo.repeat ? "true" : undefined}>
                {logo.exists ? (
                  <img src={logo.file} alt={copy === 0 && !logo.repeat ? logo.name : ""} loading="lazy" width="160" height="60" />
                ) : (
                  <span class="imgslot lw__slot">
                    <span class="imgslot__name">{logo.name}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .lw {
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--rule);
    background: var(--canvas);
  }

  .lw__label {
    margin-bottom: 1rem;
  }

  .lw__viewport {
    overflow: hidden;
    /* Logos fade in and out at the edges instead of being cut off. */
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .lw__track {
    display: flex;
    width: max-content;
    animation: lw-scroll var(--lw-duration) linear infinite;
  }

  .lw__viewport:hover .lw__track {
    animation-play-state: paused;
  }

  .lw__run {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 4vw, 3.5rem);
    /* Trailing space equal to the gap, so the join between runs matches. */
    padding: 0 clamp(2rem, 4vw, 3.5rem) 0 0;
    margin: 0;
    list-style: none;
  }

  /* One tile for every logo. The marks arrive in wildly different shapes and
     a few carry their own dark background, so without a common frame the
     strip reads as a row of mismatched stickers. */
  .lw__item {
    flex: none;
    width: 196px;
    height: 92px;
    display: grid;
    place-items: center;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: #fff;
    opacity: 1;
    transition: opacity var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .lw__item:hover { border-color: var(--glass-line); }

  @media (prefers-reduced-motion: reduce) {
    .lw__item { transition: none; }
  }

  .lw__item img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lw__slot {
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 0.4rem;
  }

  @keyframes lw-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .lw__track { animation: none; width: auto; }
    .lw__viewport { -webkit-mask-image: none; mask-image: none; }
    .lw__run { flex-wrap: wrap; justify-content: center; padding: 0 var(--gutter); }
    .lw__run[aria-hidden="true"],
    .lw__item--repeat { display: none; }
  }
</style>

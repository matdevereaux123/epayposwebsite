---
import { site } from "../lib/content";

const year = new Date().getFullYear();
const socialLabels: Record<string, string> = {
  instagram: "Instagram",
  facebook: "Facebook",
  linkedin: "LinkedIn",
  youtube: "YouTube",
  tiktok: "TikTok",
};
---

<footer class="ftr">
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <img class="ftr__logo" src={site.brand.logo} alt={site.brand.name} width={site.brand.logo_width} height={site.brand.logo_height} />
      <address class="ftr__contact">
        <p>{site.contact.address}</p>
        <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        <p class="figure">
          Sales <a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a> ext. {site.contact.sales_ext}
        </p>
        <p class="figure">
          Support <a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a> ext. {site.contact.support_ext}
        </p>
      </address>
    </div>

    {site.nav
      .filter((item) => "children" in item && item.children)
      .map((item) => (
        <div class="ftr__col">
          <p class="mono-label">{item.label}</p>
          <ul>
            {item.children!.map((c) => (
              <li><a href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined} rel={c.href.startsWith("http") ? "noopener" : undefined}>{c.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
  </div>

  <div class="wrap ftr__bottom">
    <ul class="ftr__social">
      {Object.entries(site.social).map(([key, url]) => (
        <li><a href={url} rel="noopener" target="_blank">{socialLabels[key] ?? key}</a></li>
      ))}
    </ul>
    <div class="ftr__apps">
      <a href={site.apps.ios} rel="noopener">iOS app</a>
      <a href={site.apps.android} rel="noopener">Android app</a>
    </div>
    <p class="ftr__legal">© {year} {site.brand.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .ftr {
    background: var(--canvas);
    color: var(--text-muted);
    padding-top: var(--section-y);
    border-top: 1px solid var(--rule);
  }

  .ftr__grid {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 2rem;
  }

  /* One row, whatever the group count. grid-auto-flow: column puts the brand
     in the first track and lets every nav group create its own after it — so
     adding a sixth dropdown does not push a column onto a second row, which
     is exactly what happened when Products became a mega-menu.
     minmax(0, 1fr) lets a column shrink below its longest label instead of
     forcing the grid wider. */
  @media (min-width: 900px) {
    .ftr__grid {
      grid-template-columns: 1.15fr;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }
  }

  .ftr__col .mono-label { margin-bottom: 0.5rem; }

  .ftr__col ul { font-size: 0.8125rem; line-height: 1.45; }
  .ftr__col li { margin-bottom: 0.35rem; }
  .ftr__col a {
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease);
  }
  .ftr__col a:hover { color: var(--accent-deep); }

  /* 1.5rem, not 0.75 — the "A division of" line used to carry the gap down
     to the address block and it is gone now. */
  .ftr__logo { height: 44px; width: auto; margin-bottom: 1.5rem; }


  .ftr__contact { font-style: normal; font-size: var(--small); }
  .ftr__contact p { margin-bottom: 0.35rem; }
  .ftr__contact a:hover { color: var(--epay); }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
    font-size: var(--small);
  }

  .ftr__social { display: flex; flex-wrap: wrap; gap: 1rem; }
  .ftr__social a:hover, .ftr__apps a:hover { color: var(--epay); }
  .ftr__apps { display: flex; gap: 1rem; }
  .ftr__legal { margin: 0; margin-left: auto; }
</style>

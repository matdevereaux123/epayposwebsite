---
// Small line-art icon for each free download, drawn in the logo's stroke
// style and gradient. The card that holds it plays a short animation once
// when it scrolls into view and again on hover or keyboard focus (classes
// set in LeadMagnets.astro). Nothing loops, nothing draws itself in, and it
// all stops for reduce-motion visitors.

interface Props {
  id: string;
}

const { id } = Astro.props;
const g = `lmg-${id}`;

// Five-point star, centered on 0,0.
const star = (cx: number, cy: number, R = 4.4, r = 1.9) =>
  Array.from({ length: 10 }, (_, i) => {
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    const rad = i % 2 === 0 ? R : r;
    return `${(cx + rad * Math.cos(a)).toFixed(2)},${(cy + rad * Math.sin(a)).toFixed(2)}`;
  }).join(" ");
---

<svg class={`lm-ic lm-ic--${id}`} viewBox="0 0 64 64" width="96" height="96" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={g} x1="0" y1="64" x2="64" y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0" style="stop-color: var(--logo-cyan)" />
      <stop offset="0.6" style="stop-color: var(--logo-blue)" />
      <stop offset="1" style="stop-color: var(--logo-violet)" />
    </linearGradient>
  </defs>
  <g fill="none" stroke={`url(#${g})`} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    {id === "statement-checklist" && (
      <>
        <rect x="12" y="7" width="32" height="44" rx="4" />
        <path d="M19 17h18M19 24h18M19 31h12M19 38h8" />
        <g class="lm-ic__mag">
          <circle cx="40" cy="41" r="9" style="fill: var(--canvas)" />
          <path d="M46.5 47.5 55 56" />
          <path d="M36.5 41h7" opacity="0.7" />
        </g>
      </>
    )}

    {id === "google-business-profile" && (
      <>
        <path d="M32 5c-8.8 0-15 6.6-15 15 0 11.2 15 23 15 23s15-11.8 15-23c0-8.4-6.2-15-15-15z" />
        <circle cx="32" cy="20" r="5.5" />
        {[12, 22, 32, 42, 52].map((x, i) => (
          <polygon class="lm-ic__star" style={`--i:${i}`} points={star(x, 55)} fill={`url(#${g})`} />
        ))}
      </>
    )}

    {id === "restaurant-business-plan" && (
      <>
        <rect x="13" y="10" width="38" height="48" rx="4" />
        <rect x="24" y="6" width="16" height="8" rx="2" style="fill: var(--canvas)" />
        {[22, 33, 44].map((y, i) => (
          <>
            <rect x="20" y={y} width="7" height="7" rx="1.5" />
            <path d={`M32 ${y + 3.5}h13`} />
            <path class="lm-ic__tick" style={`--i:${i}`} d={`M21.2 ${y + 3.6}l2 2 3.6-4.2`} stroke-width="2.2" />
          </>
        ))}
      </>
    )}

    {id === "food-cost-calculator" && (
      <>
        <rect x="15" y="5" width="34" height="54" rx="5" />
        <rect x="20" y="10" width="24" height="11" rx="2" />
        <path class="lm-ic__digits" d="M29 15.5h11" />
        <text x="23" y="19" font-size="8" style="font-family: var(--font-data)" fill={`url(#${g})`} stroke="none">$</text>
        {[0, 1, 2].map((row) =>
          [0, 1, 2].map((colI) => (
            <rect
              class="lm-ic__key"
              style={`--i:${row * 3 + colI}`}
              x={20 + colI * 8.5}
              y={27 + row * 9.5}
              width="6"
              height="6"
              rx="1.5"
            />
          ))
        )}
      </>
    )}

    {id === "bar-pour-cost" && (
      <>
        <g class="lm-ic__bottle">
          <path d="M20 6h7v8l4 6v27a3 3 0 0 1-3 3h-9a3 3 0 0 1-3-3V20l4-6z" />
          <path d="M16 31h15" opacity="0.7" />
        </g>
        <circle class="lm-ic__drop" cx="44" cy="30" r="1.8" fill={`url(#${g})`} stroke="none" />
        <path d="M36 38h17l-3 17a3 3 0 0 1-3 3h-5a3 3 0 0 1-3-3z" />
        <path d="M38 46h13" opacity="0.7" />
      </>
    )}
  </g>
</svg>

<style>
  .lm-ic { display: block; overflow: visible; }
  .lm-ic * { transform-box: fill-box; }

  /* Resting states: stars dim, ticks hidden, drop hidden. */
  .lm-ic__star { fill-opacity: 0.18; transform-origin: center; }
  .lm-ic__tick { opacity: 0; transform-origin: center; }
  .lm-ic__drop { opacity: 0; }
  .lm-ic__bottle { transform-origin: 100% 100%; }
  .lm-ic__key { transform-origin: center; }

  /* Ticks and filled stars are the "after" state: show them still when
     motion is reduced, so the icon reads the same without animating. */
  @media (prefers-reduced-motion: reduce) {
    .lm-ic__star { fill-opacity: 1; }
    .lm-ic__tick { opacity: 1; }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.lm__card:is(:hover, :focus-within, .is-play)) .lm-ic__mag { animation: lm-scan 1.4s var(--ease) both; }
    :global(.lm__card:is(:hover, :focus-within, .is-play)) .lm-ic__star { animation: lm-star 1.4s var(--ease) both; animation-delay: calc(var(--i) * 120ms); }
    :global(.lm__card:is(:hover, :focus-within, .is-play)) .lm-ic__tick { animation: lm-tick 1.6s var(--ease) both; animation-delay: calc(var(--i) * 220ms); }
    :global(.lm__card:is(:hover, :focus-within, .is-play)) .lm-ic__key { animation: lm-key 0.9s var(--ease) both; animation-delay: calc(var(--i) * 70ms); }
    :global(.lm__card:is(:hover, :focus-within, .is-play)) .lm-ic__digits { animation: lm-blink 1.2s steps(2, end) both; }
    :global(.lm__card:is(:hover, :focus-within, .is-play)) .lm-ic__bottle { animation: lm-tilt 1.6s var(--ease) both; }
    :global(.lm__card:is(:hover, :focus-within, .is-play)) .lm-ic__drop { animation: lm-drop 1.6s var(--ease) both; }
  }

  @keyframes lm-scan {
    0% { transform: translate(0, 0); }
    45% { transform: translate(-13px, -15px); }
    100% { transform: translate(0, 0); }
  }
  @keyframes lm-star {
    0% { fill-opacity: 0.18; transform: scale(1); }
    25% { fill-opacity: 1; transform: scale(1.35); }
    45%, 80% { fill-opacity: 1; transform: scale(1); }
    100% { fill-opacity: 0.18; transform: scale(1); }
  }
  @keyframes lm-tick {
    0% { opacity: 0; transform: scale(0.2); }
    35% { opacity: 1; transform: scale(1.3); }
    55%, 85% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1); }
  }
  @keyframes lm-key {
    0%, 100% { transform: scale(1); }
    40% { transform: scale(0.72); }
  }
  @keyframes lm-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }
  @keyframes lm-tilt {
    0%, 100% { transform: rotate(0); }
    35%, 65% { transform: rotate(38deg); }
  }
  @keyframes lm-drop {
    0%, 35% { opacity: 0; transform: translateY(0); }
    45% { opacity: 1; transform: translateY(0); }
    75% { opacity: 1; transform: translateY(10px); }
    85%, 100% { opacity: 0; transform: translateY(12px); }
  }
</style>

---
// Nav is generated entirely from content/site.json.
// To add or reorder a page, edit that file — never this component.
import { site } from "../lib/content";

const nav = site.nav;
const clean = (href: string) => (href.split("#")[0].replace(/\/$/, "") || "/");
const path = clean(Astro.url.pathname);

/** Which top-level item gets the blue underline on this page: a direct
 *  top-level link wins (Home, Pricing); otherwise the first menu, left to
 *  right, that lists this page. Pages in no menu underline nothing. */
const currentLabel =
  nav.find((item) => "href" in item && item.href && clean(item.href) === path)?.label ??
  nav.find((item) => "children" in item && item.children?.some((c) => clean(c.href) === path))?.label ??
  null;

/** Children carry a `group` label; collapse them into ordered columns. */
function grouped(children: { label: string; href: string; group?: string }[]) {
  const out: { title: string; items: typeof children }[] = [];
  for (const child of children) {
    const title = child.group ?? "";
    let col = out.find((c) => c.title === title);
    if (!col) {
      col = { title, items: [] };
      out.push(col);
    }
    col.items.push(child);
  }
  return out;
}
---

<header class="hdr" data-header>
  <div class="hdr__inner wrap">
    <a class="hdr__logo" href="/" aria-label={`${site.brand.name} home`}>
      <img src={site.brand.logo} alt={`${site.brand.name}`} width={site.brand.logo_width} height={site.brand.logo_height} />
    </a>

    <nav class="hdr__nav" aria-label="Main">
      <ul class="hdr__list">
        {nav.map((item) =>
          "children" in item && item.children ? (
            <li class="hdr__item hdr__item--has-menu">
              <button
                class="hdr__link"
                aria-expanded="false"
                aria-haspopup="true"
                aria-current={item.label === currentLabel ? "true" : undefined}
              >
                {item.label}
                <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" />
                </svg>
              </button>
              <div class="hdr__menu mega">
                {item.featured && item.featured.length > 0 && (
                  <div class="mega__rail">
                    {item.featured.map((f) => (
                      <a
                        class="mega__promo"
                        href={f.href}
                        target={f.href.startsWith("http") ? "_blank" : undefined}
                        rel={f.href.startsWith("http") ? "noopener" : undefined}
                      >
                        <span class="mega__promo-eyebrow">Featured</span>
                        <span class="mega__promo-title">{f.label}</span>
                        <span class="mega__promo-body">{f.body}</span>
                      </a>
                    ))}
                  </div>
                )}
                <div class="mega__cols">
                  {grouped(item.children).map((col) => (
                    <div class="mega__col">
                      {col.title && <p class="mega__col-title">{col.title}</p>}
                      <ul>
                        {col.items.map((child) => (
                          <li>
                            <a
                              href={child.href}
                              target={child.href.startsWith("http") ? "_blank" : undefined}
                              rel={child.href.startsWith("http") ? "noopener" : undefined}
                              aria-current={path === clean(child.href) && !child.href.includes("#") ? "page" : undefined}
                            >
                              {child.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </li>
          ) : (
            <li class="hdr__item">
              <a
                class="hdr__link"
                href={item.href}
                aria-current={item.label === currentLabel ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="hdr__login" href={site.cta.login.href}>{site.cta.login.label}</a>
      <a class="btn btn--primary hdr__cta" href={site.cta.primary.href}>
        {site.cta.primary.label}
      </a>
      <button class="hdr__burger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Deliberately OUTSIDE <header>. The header sets backdrop-filter, and any
     filter/transform makes that element the containing block for a
     position: fixed descendant. With this panel inside it, `inset: 76px 0 0`
     resolved against the header's 77px box instead of the viewport, so the
     menu opened 40px tall with all 66 links clipped out of sight - while the
     open handler still locked body scroll, which read as the page freezing. -->
<nav class="mnav" id="mobile-nav" aria-label="Menu" hidden>
  <div class="mnav__inner">
    {nav.map((item) =>
      "children" in item && item.children ? (
        /* <details> rather than a button + JS: it collapses natively, is
           keyboard operable for free, and still opens if the script never
           runs. The section holding the current page starts open. */
        <details class="mnav__group mnav__group--drop" open={item.label === currentLabel}>
          <summary class="mnav__summary">
            <span class="mono-label">{item.label}</span>
            <svg class="mnav__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul>
            {item.children.map((c) => (
              <li><a href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined} rel={c.href.startsWith("http") ? "noopener" : undefined}>{c.label}</a></li>
            ))}
          </ul>
        </details>
      ) : (
        <div class="mnav__group">
          <a class="mnav__top" href={item.href}>{item.label}</a>
        </div>
      )
    )}
    <div class="mnav__actions">
      <a class="btn btn--primary" href={site.cta.primary.href}>{site.cta.primary.label}</a>
      <a class="btn btn--ghost" href={site.cta.login.href}>{site.cta.login.label}</a>
    </div>
  </div>
</nav>

<script>
  const header = document.querySelector("[data-header]");
  const burger = document.querySelector(".hdr__burger");
  const mnav = document.getElementById("mobile-nav");

  window.addEventListener(
    "scroll",
    () => header?.classList.toggle("is-scrolled", window.scrollY > 12),
    { passive: true }
  );

  burger?.addEventListener("click", () => {
    const open = burger.getAttribute("aria-expanded") === "true";
    burger.setAttribute("aria-expanded", String(!open));
    if (mnav) mnav.hidden = open;
    document.body.style.overflow = open ? "" : "hidden";
  });

  // Dropdowns open on hover where there is a real pointer, and on click
  // everywhere — touch devices have no hover, so click has to keep working.
  // aria-expanded is set either way so assistive tech never sees a collapsed
  // menu that is visually open.
  const finePointer = window.matchMedia("(min-width: 1024px) and (hover: hover)");
  let closeTimer: number | undefined;

  const closeAll = () =>
    document
      .querySelectorAll(".hdr__item--has-menu > button")
      .forEach((b) => b.setAttribute("aria-expanded", "false"));

  const openOnly = (btn: Element) => {
    closeAll();
    btn.setAttribute("aria-expanded", "true");
  };

  document.querySelectorAll(".hdr__item--has-menu").forEach((li) => {
    const btn = li.querySelector("button");
    if (!btn) return;

    li.addEventListener("mouseenter", () => {
      if (!finePointer.matches) return;
      window.clearTimeout(closeTimer);
      openOnly(btn);
    });

    // Small grace period: moving the mouse diagonally from the trigger to the
    // panel briefly leaves both, and without this the menu snaps shut.
    li.addEventListener("mouseleave", () => {
      if (!finePointer.matches) return;
      closeTimer = window.setTimeout(closeAll, 180);
    });

    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      closeAll();
      if (!isOpen) btn.setAttribute("aria-expanded", "true");
    });

    li.addEventListener("focusin", () => openOnly(btn));
    li.addEventListener("focusout", (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (!next || !li.contains(next)) closeAll();
    });
  });

  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest(".hdr__item--has-menu")) closeAll();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAll();
  });
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rule);
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .hdr.is-scrolled {
    border-bottom-color: var(--rule-strong);
    background: rgba(255, 255, 255, 0.98);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 76px;
  }

  .hdr__logo { flex-shrink: 0; display: flex; align-items: center; }

  /* The mark is ~3.4:1 wide. Height is locked and width derived, so a
     re-export at a different pixel size can't shift the header layout. */
  .hdr__logo img {
    height: 38px;
    width: auto;
  }

  .hdr__nav {
    display: none;
    flex: 1;
  }

  .hdr__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .hdr__item {
    position: relative;
  }

  /* The four dropdown triggers are <button>, the rest are <a>. A button does
     not inherit line-height — the UA stylesheet sets it to `normal` — so
     without this the triggers came out 33px tall against 39.1px for the
     links, putting their centres 3px above Products, Pricing and Login.
     Set it explicitly so both elements produce the same box. */
  .hdr__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.7rem;
    margin: 0;
    font-size: var(--small);
    font-weight: var(--weight-ui);
    font-family: var(--font-body);
    line-height: 1.65;
    color: var(--text-muted);
    background: none;
    border: 0;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: color var(--dur-fast) var(--ease);
  }

  .hdr__link:hover,
  .hdr__link[aria-current] {
    color: var(--text);
  }

  /* Active page gets a hairline in the logo gradient rather than a color
     swap, so "where am I" survives at a glance. */
  .hdr__link[aria-current]::before {
    content: "";
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.15rem;
    height: 2px;
    border-radius: 2px;
    background: var(--logo-sweep);
  }

  .hdr__item--has-menu > button[aria-expanded="true"] {
    color: var(--text);
  }

  .hdr__menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 240px;
    /* Was rgba(255,255,255,0.88) — too sheer. At 12% pass-through the panel
       took its tone from whatever it floated over, so the menu went muddy
       above the ink band and washed out above white. A tinted fill at 0.96
       lets only 4% through: still visibly glass, but the text now sits on a
       known colour instead of a variable one. */
    background: rgba(255, 255, 255, 0.97);
    -webkit-backdrop-filter: blur(22px) saturate(1.6);
    backdrop-filter: blur(22px) saturate(1.6);
    box-shadow: 0 16px 48px rgba(6, 20, 32, 0.18);
    border: 1px solid var(--rule-btn);
    border-radius: var(--radius-lg);
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: all var(--dur-fast) var(--ease);
  }

  .hdr__item--has-menu > button[aria-expanded="true"] + .hdr__menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  /* --text, not --text-muted. Muted grey is right for nav triggers sitting on
     the solid header, but inside a translucent panel it was the larger half
     of the legibility problem. */
  .hdr__menu a {
    position: relative;
    display: block;
    padding: 0.55rem 0.75rem;
    font-size: var(--small);
    color: var(--text);
    border-radius: var(--radius-sm);
    transition:
      background var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      padding-left var(--dur-fast) var(--ease);
  }

  .hdr__menu a:hover {
    background: rgba(0, 208, 250, 0.2);
    color: var(--accent-deep);
    padding-left: 1rem;
  }

  /* Invisible bridge across the 8px gap between trigger and panel. Without
     it the pointer leaves both elements on the way down and the menu closes.
     Absolutely positioned so it is out of the button's flex flow. */
  .hdr__item--has-menu > button::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 14px;
  }

  /* ---------- Mega-menu ---------- */

  /* The panel is far wider than its trigger, so it is centred on the header
     rather than anchored to the <li>. Centring uses the `translate` property,
     not `transform`, because the open state sets `transform: none` and the
     two would fight. They are independent properties and both apply. */
  @media (min-width: 1024px) {
    .hdr__item--has-menu { position: static; }
  }

  .mega {
    display: grid;
    grid-template-columns: 264px 1fr;
    width: min(920px, calc(100vw - 2 * var(--gutter)));
    min-width: 0;
    padding: 0;
    left: 50%;
    translate: -50% 0;
    overflow: hidden;
  }

  /* One column when there is no featured rail. */
  .mega:not(:has(.mega__rail)) { grid-template-columns: 1fr; width: min(620px, calc(100vw - 2 * var(--gutter))); }

  .mega__rail {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.1rem 1rem;
    background: var(--canvas);
    border-right: 1px solid var(--rule-strong);
  }

  /* Scoped under .hdr__menu so these beat `.hdr__menu a`, which is 0,1,1 and
     otherwise forces display:block and its own padding onto the promo. */
  .hdr__menu .mega__promo {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition:
      background var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  /* --surface, not --canvas: the rail is flat white now, so a white hover
     would be invisible. */
  .hdr__menu .mega__promo:hover {
    background: var(--glass);
    border-color: var(--glass-line);
    padding-left: 0.85rem;
  }

  .hdr__menu .mega__promo > span { display: block; }

  .mega__promo-eyebrow {
    font-family: var(--font-data);
    font-size: 0.625rem;
    font-weight: var(--weight-ui);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent-deep);
  }

  .mega__promo-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    color: var(--text);
  }

  .mega__promo-body {
    font-size: var(--small);
    line-height: 1.45;
    color: var(--text-muted);
  }

  .mega__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0.5rem 1.25rem;
    align-content: start;
    padding: 1.1rem 1.25rem;
    background: transparent;
  }

  .mega__col-title {
    font-family: var(--font-data);
    font-size: 0.625rem;
    font-weight: var(--weight-ui);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0.35rem 0 0.35rem 0.75rem;
  }

  .mega__col a { font-weight: var(--weight-ui); }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .hdr__login {
    font-size: var(--small);
    color: var(--text-muted);
  }

  .hdr__login:hover {
    color: var(--text);
  }

  .hdr__cta {
    display: none;
    padding-block: 0.6rem;
  }

  .hdr__burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 40px;
    height: 40px;
    padding: 0 8px;
    background: none;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .hdr__burger span {
    display: block;
    height: 1.5px;
    background: var(--text);
  }

  .mnav {
    position: fixed;
    inset: 76px 0 0;
    /* One below the header's 100. The panel lives outside <header> (see the
       note in the markup), so it no longer inherits that stacking level and
       needs its own - without this it opens at the right size but paints
       under the page content. */
    z-index: 99;
    background: var(--canvas);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--gutter);
  }

  .mnav__group {
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  /* A collapsed section is a row you tap, so the row - not just the text -
     has to be a 44px target. The group padding shrinks to match so the
     closed menu stays compact. */
  .mnav__group--drop {
    padding-block: 0.25rem;
  }

  .mnav__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
  }

  .mnav__summary::-webkit-details-marker {
    display: none;
  }

  .mnav__summary .mono-label {
    margin: 0;
  }

  .mnav__chev {
    flex: none;
    color: var(--text-muted);
  }

  .mnav__group--drop[open] .mnav__chev {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mnav__chev {
      transition: transform 160ms ease;
    }
  }

  .mnav__group--drop > ul {
    padding-block: 0.25rem 0.75rem;
  }

  .mnav__group a {
    display: block;
    padding: 0.4rem 0;
    color: var(--text-muted);
  }

  .mnav__top {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--text) !important;
  }

  .mnav__actions {
    display: grid;
    gap: 0.75rem;
    padding-top: 1.5rem;
  }

  @media (min-width: 1024px) {
    .hdr__nav,
    .hdr__cta {
      display: flex;
    }
    .hdr__burger,
    .mnav {
      display: none;
    }
  }
</style>

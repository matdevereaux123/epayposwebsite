---
import Base from "../layouts/Base.astro";
import BatchLine from "../components/BatchLine.astro";
import { pricing, faqs, money, site, startingPrice, headings } from "../lib/content";

const choose = (pricing as any).choose;
const custom = (pricing as any).custom;
const subs = (pricing as any).subscriptions;
const copy = (site as any).page_copy.pricing;

/** Each option reads its rate and blurb from processing, so the two never drift. */
const options = choose.options.map((o: any) => ({
  ...o,
  data: (pricing as any).processing[o.source],
}));

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base
  title={`POS Pricing & Processing Rates | ${site.brand.name}`}
  description={`Software from ${money(startingPrice())}/mo. Flat ${pricing.processing.flat_rate.display} processing or 0% with cash discount. No long-term contract.`}
  schema={faqSchema}
>
  <section class="band band--deck hero">
    <div class="wrap">
      <p class="mono-label">Pricing</p>
      <h1>{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
    </div>
  </section>

  <BatchLine
    readouts={[
      { label: "Software from", value: `${money(startingPrice())}/mo` },
      { label: "Processing", value: pricing.processing.flat_rate.display },
      { label: "Contract", value: "None" },
    ]}
  />

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">{choose.eyebrow}</p>
      <h2>{choose.heading}</h2>
      <div class="grid grid--2 choose">
        {options.map((opt: any) => (
          <article class={`card choose__card ${opt.highlight ? "choose__card--hl" : ""}`}>
            <p class="rate choose__figure">{opt.data.display}</p>
            <h3>{opt.data.label}</h3>
            <p class="choose__for">{opt.best_for}</p>
            <p>{opt.data.body}</p>
            <ul class="choose__points">
              {opt.points.map((pt: string) => <li>{pt}</li>)}
            </ul>
            <div class="actions">
              <a class="btn btn--primary" href={choose.cta_href}>{choose.cta_label}</a>
              <a class="btn btn--ghost" href={opt.learn_more}>How it works</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Software plans</p>
      <h2>{headings.shared.plans}</h2>
      <div class="grid grid--4">
        {pricing.plans.map((plan) => (
          <article class={`card reveal plan ${plan.highlight ? "plan--hl" : ""}`}>
            {plan.highlight && <p class="mono-label">{plan.badge}</p>}
            <h2 class="plan__name">{plan.name}</h2>
            <p class="price">{money(plan.price)}<span class="plan__int">/{plan.interval}</span></p>
            <p class="plan__for">{plan.best_for}</p>
            <a class={`btn ${plan.highlight ? "btn--primary" : "btn--ghost"} plan__cta`} href={site.cta.primary.href}>
              {site.cta.primary.label}
            </a>
            <ul class="plan__list">
              {plan.features.map((f) => <li>{f}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <article class="custom">
        <div class="custom__copy">
          <p class="mono-label">{custom.eyebrow}</p>
          <h2>{custom.heading}</h2>
          <p class="lede">{custom.body}</p>
          <div class="actions">
            <a class="btn btn--primary" href={custom.cta.href}>{custom.cta.label}</a>
            <a class="btn btn--ghost" href={custom.secondary.href}>{custom.secondary.label}</a>
          </div>
        </div>
        <ul class="custom__points">
          {custom.points.map((pt: string) => <li>{pt}</li>)}
        </ul>
      </article>
    </div>
  </section>

  {subs.items.length > 0 && (
    <section class="band band--dark">
      <div class="wrap">
        <p class="mono-label">{subs.eyebrow}</p>
        <h2>{subs.heading}</h2>
        <p class="lede">{subs.lede}</p>
        <ul class="subs">
          {subs.items.map((item: any) => (
            <li class="subs__row">
              <span class="subs__name">
                {item.name}
                {item.unit && <span class="subs__unit">{item.unit}</span>}
              </span>
              <span class="subs__body">{item.body}</span>
              <span class="subs__price figure">
                {item.price !== null ? (
                  <>{money(item.price)}<span class="subs__int">/{item.interval}</span></>
                ) : (
                  <span class="subs__terms">{item.terms}</span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="band band--light">
    <div class="wrap">
      <p class="mono-label">Included with every plan</p>
      <h2>{headings.shared.included}</h2>
      <ul class="incl">
        {pricing.included_with_every_plan.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="band band--surface">
    <div class="wrap">
      <p class="mono-label">Programs</p>
      <h2>{headings.pricing.save}</h2>
      <div class="grid grid--2">
        {pricing.programs.map((program) => (
          <article class="card reveal">
            <h3>{program.name}</h3>
            <p>{program.body}</p>
            {program.cta && <a class="btn btn--ghost" href={program.cta.href}>{program.cta.label}</a>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--light">
    <div class="wrap">
      <p class="mono-label">Questions</p>
      <h2>{headings.shared.faq}</h2>
      <div class="faqs">
        {faqs.map((faq) => (
          <details class="faq">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(4rem, 10vw, 8rem) clamp(2.5rem, 5vw, 4rem); }
  .hero h1 { max-width: 18ch; }

  .plan { display: flex; flex-direction: column; }
  .plan--hl { border-color: var(--epay); }
  .plan__name { font-size: var(--heading); margin-bottom: 0.25rem; }
  .plan .price { font-size: 1.875rem; color: var(--text); margin: 0 0 0.5rem; }
  .plan__int { font-size: var(--small); color: var(--accent-deep); }
  .plan__for { font-size: var(--small); color: var(--text-muted); }
  .plan__cta { width: 100%; margin-block: 0.5rem 0.5rem; }
  .plan__list { margin-top: auto; }
  .plan__list li {
    font-size: var(--small);
    padding-block: 0.55rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }

  .choose { margin-top: 2rem; }
  .choose__card { display: flex; flex-direction: column; }
  .choose__card--hl { border-color: var(--epay); }
  .choose__figure {
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--accent-deep);
    margin: 0 0 0.25rem;
    line-height: 1;
  }
  .choose__for { font-size: var(--small); color: var(--text-muted); }
  .choose__points { margin: 0.5rem 0 auto; }
  .choose__points li {
    font-size: var(--small);
    padding-block: 0.55rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }
  .choose .actions { margin-top: 1.5rem; }

  /* Landscape panel — deliberately wide rather than another card in a row,
     so a large operator does not read it as a fifth plan. */
  .custom {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--epay);
    border-radius: var(--radius-lg);
    background: var(--glass);
  }
  @media (min-width: 900px) {
    .custom { grid-template-columns: 1.35fr 1fr; gap: 3rem; align-items: center; }
  }
  .custom__points li {
    padding-block: 0.7rem;
    border-top: 1px solid var(--rule-strong);
    color: var(--text-muted);
    font-size: var(--small);
  }

  .subs { margin-top: 1.5rem; }
  .subs__row {
    display: grid;
    gap: 0.15rem 1.5rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 760px) {
    .subs__row { grid-template-columns: 1fr 2fr auto; align-items: baseline; }
  }
  .subs__name { font-weight: var(--weight-ui); }
  .subs__unit {
    display: block;
    font-family: var(--font-data);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }
  .subs__terms { font-size: var(--small); color: var(--text-muted); }
  .subs__body { font-size: var(--small); color: var(--text-muted); }
  .subs__price { color: var(--text); }
  .subs__int { font-size: var(--small); color: var(--accent-deep); }

  .incl { display: grid; gap: 0.25rem; margin-top: 1.5rem; }
  @media (min-width: 700px) { .incl { grid-template-columns: 1fr 1fr; } }
  .incl li { padding-block: 0.75rem; border-top: 1px solid var(--rule); }

  .faqs { margin-top: 2rem; max-width: 760px; }

  .faq { border-top: 1px solid var(--rule); }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.1rem 0.85rem;
    margin-inline: -0.85rem;
    border-radius: var(--radius);
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    list-style: none;
    transition: background var(--dur-fast) var(--ease);
  }
  .faq summary:hover { background: var(--glass); }
  .faq summary::-webkit-details-marker { display: none; }

  /* Was var(--depth), which is not a defined token — the marker fell back to
     inherited text color. A single "+" that rotates into "×" avoids swapping
     the glyph, so the transition is continuous. */
  .faq summary::after {
    content: "+";
    flex-shrink: 0;
    font-family: var(--font-data);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--accent-deep);
    transition: transform var(--dur) var(--ease);
  }
  .faq[open] summary::after { transform: rotate(135deg); }
  .faq p { color: var(--text-muted); padding-bottom: 1rem; max-width: 68ch; }
</style>

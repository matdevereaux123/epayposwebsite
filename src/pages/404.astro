---
import Base from "../layouts/Base.astro";
import { industries, headings } from "../lib/content";
---
<Base noindex title="Page not found | EPAY POS" description="That page doesn't exist.">
  <section class="band band--deck nf">
    <div class="wrap">
      <p class="mono-label">404</p>
      <h1>{headings.system.not_found}</h1>
      <p class="lede">It may have moved. Here's where most people are headed:</p>
      <ul class="nf__list">
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/epay-products-1">Hardware</a></li>
        <li><a href="/book-a-demo">Book a demo</a></li>
        {industries.slice(0, 4).map((i) => <li><a href={`/${i.slug}`}>{i.name}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
<style>
  .nf { padding-block: clamp(5rem, 12vw, 9rem); }
  .nf__list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2rem; }
  .nf__list a {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: var(--small);
    color: var(--text-muted);
  }
  .nf__list a:hover { border-color: var(--accent-deep); color: var(--text); }
</style>

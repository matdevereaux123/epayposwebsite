---
// One page per product. Generated from products.json — adding a product
// there creates its page, exactly like industries and features.
//
// Namespaced under /product/ so a whole new line (the nail salon POS, the
// online portals) can slot in beside the restaurant hardware later without
// colliding with the top-level industry and feature slugs.

import Base from "../../layouts/Base.astro";
import BatchLine from "../../components/BatchLine.astro";
import ImageSlot from "../../components/ImageSlot.astro";
import { products, pricing, site, money, faqs, capabilitiesFor, integrationsFor, headings, fill, titleCase, leaseMonthly } from "../../lib/content";

export function getStaticPaths() {
  return (products as any[]).map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props as any;
const hw = (pricing as any).hardware;

const leaseRate =
  leaseMonthly(product);

const others = (products as any[]).filter((p) => p.id !== product.id);

// Retail hardware gets the retail capability set; everything else restaurant.
const audience = product.id === "epay-retail" ? "retail" : "restaurant";
const caps = capabilitiesFor(audience as any);
const integs = integrationsFor(audience as any);

// A product's own FAQs (products.json) render on the page and are marked up
// as FAQPage next to the Product schema. Written per product, so each page's
// set is unique — the shared four-question subset stays unmarked, same rule
// as the industry pages.
const ownFaqs = product.faqs ?? null;
const pageFaqs = ownFaqs ?? (faqs as any[]).slice(0, 4);
const faqSchema = ownFaqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: ownFaqs.map((f: any) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.summary,
  brand: { "@type": "Brand", name: site.brand.name },
  ...(product.purchase_price
    ? {
        offers: {
          "@type": "Offer",
          price: product.purchase_price,
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
};

const schema = faqSchema ? [productSchema, faqSchema] : productSchema;

import fs from "node:fs";
import path from "node:path";

const onDisk = (file?: string) => {
  if (!file) return false;
  try {
    return fs.existsSync(path.join(process.cwd(), "public", file.replace(/^\//, "")));
  } catch {
    return false;
  }
};
const galleryShots = (product.gallery ?? []).filter((shot: any) => onDisk(shot.file));
---

<Base
  title={`${product.name} — ${product.kicker} | ${site.brand.name}`}
  description={product.meta_description ?? product.summary}
  schema={schema}
>
  <section class="band band--deck hero">
    <div class="wrap hero__grid">
      <div>
        <p class="mono-label">{product.kicker}</p>
        <h1>{product.name}</h1>
        <p class="lede">{product.summary}</p>

        <p class="pdp__price figure">
          {product.purchase_price ? money(product.purchase_price) : "Ask us"}
          {product.purchase_price && <span class="pdp__tax">{hw.purchase.tax_note}</span>}
        </p>
        <p class="pdp__alt">
          {product.free_with_lease
            ? hw.callout.free_with_lease
            : `${hw.callout.lease_prefix} ${money(leaseRate)}${hw.callout.lease_suffix}`}
        </p>
        <p class="showcase__free">
          <span class="showcase__free-dot" aria-hidden="true"></span>
          {hw.callout.placement}
        </p>

        <div class="actions">
          <a class="btn btn--primary" href="/epay-products-1#build">Build a system</a>
          <a class="btn btn--ghost" href={site.cta.primary.href}>{site.cta.primary.label}</a>
        </div>
      </div>
      <ImageSlot name={product.name} file={product.image} ratio="4 / 3" />
    </div>
  </section>

  <BatchLine
    readouts={[
      { label: "Purchase", value: product.purchase_price ? money(product.purchase_price) : "Ask us" },
      { label: "Lease", value: product.free_with_lease ? "Free on a system lease" : `${money(leaseRate)}/mo` },
      { label: "Placement", value: "Free if you qualify" },
    ]}
  />

  <section class="band band--dark">
    <div class="wrap pdp__grid">
      <div>
        <p class="mono-label">What it does</p>
        <h2>{fill(headings.product.built_for, { list: product.best_for.map(titleCase).join(", ") })}</h2>
        <p>{product.body}</p>
      </div>
      <ul class="pdp__features">
        {product.feature_bullets.map((f: string) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">In the box</p>
      <h2>{headings.product.specs}</h2>
      <ul class="pdp__specs">
        {product.specs.map((s: string) => <li>{s}</li>)}
      </ul>
      <ul class="prods__tags">
        {product.best_for.map((t: string) => <li class="tag">{t}</li>)}
      </ul>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Built in</p>
      <h2>{fill(headings.product.can_do, { name: product.name })}</h2>
      <div class="caps">
        {caps.map((cap: any) => (
          <article class="cap">
            <h3>{cap.name}</h3>
            <p>{cap.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Integrations</p>
      <h2>{headings.shared.integrations}</h2>
      <div class="grid grid--3">
        {integs.map((integ: any) => (
          <article class="card">
            <p class="mono-label">{integ.kicker}</p>
            <h3>{integ.name}</h3>
            <p>{integ.body}</p>
            <ul class="integ__points">
              {integ.points.map((pt: string) => <li>{pt}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {galleryShots.length > 0 && (
    <section class="band band--dark">
      <div class="wrap">
        <p class="mono-label">On site</p>
        <h2>{fill(headings.product.gallery, { name: product.name })}</h2>
        <div class="grid grid--2 gallery">
          {galleryShots.map((shot: any) => (
            <ImageSlot name={shot.name} file={shot.file} ratio="4 / 3" />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Three ways to get it</p>
      <h2>{headings.product.lease}</h2>
      <div class="grid grid--3">
        <article class="card">
          <h3>{hw.purchase.label}</h3>
          <p class="pdp__way figure">
            {product.purchase_price ? money(product.purchase_price) : "Ask us"}
          </p>
          <p>{hw.purchase.body}</p>
        </article>
        <article class="card">
          <h3>{hw.lease.label}</h3>
          <p class="pdp__way figure">
            {product.free_with_lease ? "$0" : `${money(leaseRate)}/mo`}
          </p>
          <p>{product.free_with_lease ? hw.callout.free_with_lease : hw.lease.body}</p>
        </article>
        <article class="card card--accent">
          <h3>{hw.free_placement.label}</h3>
          <p class="pdp__way figure">$0</p>
          <p>{hw.free_placement.body}</p>
          <ul class="pdp__quals">
            {hw.free_placement.qualifiers.map((q: any) => <li>{q.label}</li>)}
          </ul>
        </article>
      </div>
      <div class="actions">
        <a class="btn btn--primary" href="/epay-products-1#build">Price your build</a>
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Questions</p>
      <h2>{headings.shared.faq}</h2>
      <div class="faqs">
        {pageFaqs.map((faq: any) => (
          <details class="faq">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">The rest of the lineup</p>
      <h2>{headings.product.others}</h2>
      <div class="grid grid--3">
        {others.map((p: any) => (
          <a class="card card--link" href={`/product/${p.id}`} aria-label={`${p.name} — see product`}>
            <ImageSlot name={p.name} file={p.image} ratio="4 / 3" />
            <p class="mono-label">{p.kicker}</p>
            <h3>{p.name}</h3>
            <p class="showcase__body">{p.summary}</p>
            <span class="card__go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .hero__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: 1.1fr 1fr; } }

  .pdp__price { font-size: clamp(1.75rem, 3vw, 2.25rem); color: var(--text); margin: 1.25rem 0 0.15rem; }
  .pdp__tax { font-size: var(--small); color: var(--text-muted); margin-left: 0.5rem; }
  .pdp__alt { font-family: var(--font-data); font-size: var(--small); color: var(--text-muted); margin: 0 0 0.6rem; }

  .pdp__grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 860px) { .pdp__grid { grid-template-columns: 1fr 1.1fr; gap: 3rem; } }

  .pdp__features li,
  .pdp__specs li {
    padding-block: 0.85rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }
  .pdp__features li:first-child { border-top: 0; }

  .pdp__specs { margin-top: 1.5rem; }
  @media (min-width: 700px) { .pdp__specs { columns: 2; column-gap: 2.5rem; } }

  .pdp__way { font-size: 1.5rem; color: var(--text); margin: 0.25rem 0 0.5rem; }

  .pdp__quals { margin-top: 0.75rem; }
  .pdp__quals li {
    font-size: var(--small);
    padding-block: 0.4rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }

  .gallery { margin-top: 2rem; }

  .caps { display: grid; gap: 1.25rem 2.5rem; margin-top: 2rem; }
  @media (min-width: 760px) { .caps { grid-template-columns: 1fr 1fr; } }
  .cap { padding-block: 1rem; border-top: 1px solid var(--rule); }
  .cap h3 { margin-bottom: 0.35rem; }
  .cap p { color: var(--text-muted); font-size: var(--small); margin: 0; }

  .integ__points { margin-top: 1rem; }
  .integ__points li { font-size: var(--small); padding-block: 0.5rem;
    border-top: 1px solid var(--rule); color: var(--text-muted); }

  .faqs { margin-top: 1.5rem; max-width: 760px; }
  .faq { border-top: 1px solid var(--rule); }
  .faq summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1.1rem 0.85rem; margin-inline: -0.85rem;
    border-radius: var(--radius); cursor: pointer;
    font-family: var(--font-display); font-weight: 700; font-size: 1.0625rem;
    list-style: none;
    transition: background var(--dur-fast) var(--ease);
  }
  .faq summary:hover { background: var(--glass); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: "+"; flex-shrink: 0; font-family: var(--font-data);
    font-size: 1.25rem; line-height: 1; color: var(--accent-deep);
    transition: transform var(--dur) var(--ease);
  }
  .faq[open] summary::after { transform: rotate(135deg); }
  .faq p { color: var(--text-muted); padding-bottom: 1rem; max-width: 68ch; }

  .prods__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.5rem; }
</style>

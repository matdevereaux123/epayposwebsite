---
import Base from "../layouts/Base.astro";
import BatchLine from "../components/BatchLine.astro";
import LogoWall from "../components/LogoWall.astro";
import ImageSlot from "../components/ImageSlot.astro";
import VideoSlot from "../components/VideoSlot.astro";
import HomePromos from "../components/HomePromos.astro";
import Testimonials from "../components/Testimonials.astro";
import LeadForm from "../components/LeadForm.astro";
import StatementAnalyzer from "../components/StatementAnalyzer.astro";
import {
  site,
  pricing,
  products,
  industries,
  stats,
  money,
  startingPrice,
  headings,
  planById,
  enquiry,
  leaseMonthly,
} from "../lib/content";
import terminalData from "../../content/terminal.json";

const restaurantVerticals = industries.filter((i) => i.category === "restaurant");
const retailVerticals = industries.filter((i) => i.category === "retail");
const featured = products;
const hc = (site as any).home_contact;
const heroImg = (site as any).page_images.home;

// EPAY Terminal sits in the same row, but it is software on the Mini rather
// than its own hardware — so it carries a monthly price, not a purchase one.
const terminalCard = (terminalData as any).card;
const terminalPlan = planById(terminalCard.plan_id);
---

<Base
  title="POS & Payment Processing for Restaurants & Retail | EPAY POS"
  description={`Point of sale systems and merchant processing from ${money(startingPrice())}/mo. Flat ${pricing.processing.flat_rate.display} or 0% with cash discount. Free hardware placement available.`}
>
  <!-- HERO -->
  <section class="band band--deck hero">
    <div class="wrap hero__grid">
      <div class="rise">
        <p class="mono-label">Point of sale · Merchant processing</p>
        <h1>{site.brand.tagline}</h1>
        <p class="lede">{site.brand.hero_lede}</p>
        <div class="actions">
          <a class="btn btn--primary" href={site.cta.primary.href}>{site.cta.primary.label}</a>
          <a class="btn btn--ghost" href={site.cta.secondary.href}>{site.cta.secondary.label}</a>
        </div>
      </div>
      <div class="hero__art">
        <ImageSlot name={heroImg.name} file={heroImg.file} ratio="1 / 1" width={heroImg.width} height={heroImg.height} />
      </div>
    </div>
  </section>

  <!-- SIGNATURE: the batch line -->
  <div class="batchwrap">
    <BatchLine
      readouts={[
        { label: "Merchants", value: stats.merchants, suffix: "+" },
        { label: "Flat rate", value: pricing.processing.flat_rate.display },
        {
          label: pricing.processing.cash_discount.program_name,
          value: `${pricing.processing.cash_discount.display} processing`,
        },
        { label: "Software from", value: `${money(startingPrice())}/mo` },
        { label: "Funding", value: stats.funding },
      ]}
    />
  </div>

  <!-- MERCHANT LOGOS — endless strip, directly under the banner -->
  <LogoWall />

  <!-- VERTICALS — real internal linking, good for merchants and for search -->
  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Built per business type</p>
      <h2>{headings.home.industries}</h2>
      <div class="verts">
        <div>
          <p class="mono-label">Restaurant</p>
          <ul class="vertlist">
            {restaurantVerticals.map((v) => (
              <li><a href={`/${v.slug}`}>{v.name}<span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="mono-label">Retail</p>
          <ul class="vertlist">
            {retailVerticals.map((v) => (
              <li><a href={`/${v.slug}`}>{v.name}<span aria-hidden="true">→</span></a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- HARDWARE -->
  <section class="band band--surface">
    <div class="wrap">
      <p class="mono-label">Hardware</p>
      <h2>{headings.home.hardware}</h2>
      <p class="lede">{(site as any).home_hardware.body}</p>
      <div class="grid prods">
        {featured.map((product: any) => (
          <article class="card card--link reveal showcase"
             data-enquire-reason="equipment"
             data-enquire={`product:${product.id}`}
             data-enquire-label={`Home hardware card — ${product.name}`}>
            <ImageSlot name={product.name} file={product.image} ratio="4 / 3" />
            <p class="mono-label">{product.kicker}</p>
            <h3>{product.name}</h3>
            <p class="showcase__body">{product.summary}</p>
            <p class="showcase__price figure">
              {product.purchase_price ? money(product.purchase_price) : "Ask us"}
            </p>
            <p class="showcase__alt">
              {product.free_with_lease
                ? pricing.hardware.callout.free_with_lease
                : `${pricing.hardware.callout.lease_prefix} ${money(
                    leaseMonthly(product)
                  )}${pricing.hardware.callout.lease_suffix}`}
            </p>
            <p class="showcase__free">
              <span class="showcase__free-dot" aria-hidden="true"></span>
              {pricing.hardware.callout.placement}
            </p>
            <ul class="prods__tags">
              {product.best_for.slice(0, 2).map((tag: string) => <li class="tag">{tag}</li>)}
            </ul>
            <a class="card__details" href={`/product/${product.id}`} data-enquire-keep>
              Full specs <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}

        <a class="card card--link reveal showcase" href={terminalCard.href}
           aria-label={`${(terminalData as any).heading} — see the software`}>
          <ImageSlot name={(terminalData as any).heading} file={terminalCard.image} ratio="4 / 3" />
          <p class="mono-label">{terminalCard.kicker}</p>
          <h3>{(terminalData as any).heading}</h3>
          <p class="showcase__body">{terminalCard.summary}</p>
          <p class="showcase__price figure">
            {money(terminalPlan!.price)}<span class="showcase__int">/{terminalPlan!.interval}</span>
          </p>
          <p class="showcase__alt">Runs on the EPAY Mini</p>
          <p class="showcase__free">
            <span class="showcase__free-dot" aria-hidden="true"></span>
            {pricing.hardware.callout.placement}
          </p>
          <ul class="prods__tags">
            {terminalCard.tags.map((tag: string) => <li class="tag">{tag}</li>)}
          </ul>
          <span class="card__go" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="actions">
        <a class="btn btn--primary" href="/epay-products-1">Shop hardware</a>
        <a class="btn btn--ghost" href="/epay-products-1#build">Build your system</a>
      </div>
    </div>
  </section>

  <!-- THE TWO PRICING PATHS — the clearest thing this company offers, and
       the one section that gets the dark treatment. One per page. -->
  <section class="band band--dark paths">
    <div class="wrap">
      <p class="mono-label">Two ways to pay for processing</p>
      <h2>{headings.home.paths}</h2>
      <div class="grid grid--2">
        <a class="card card--link reveal path" href="/pricing"
           aria-label={`${pricing.processing.flat_rate.label} — see full pricing`}>
          <p class="rate path__figure">{pricing.processing.flat_rate.display}</p>
          <h3>{pricing.processing.flat_rate.label}</h3>
          <p>{pricing.processing.flat_rate.body}</p>
          <span class="card__go" aria-hidden="true">→</span>
        </a>
        <a class="card card--link reveal path path--accent" href="/pricing"
           aria-label={`${pricing.processing.cash_discount.label} — see full pricing`}>
          <p class="rate path__figure">{pricing.processing.cash_discount.display}</p>
          <h3>{pricing.processing.cash_discount.label}</h3>
          <p>{pricing.processing.cash_discount.body}</p>
          <span class="card__go" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <VideoSlot />

  <!-- STATEMENT ANALYSIS — the strongest lead magnet, moved up the page -->
  <section class="band band--light analyze">
    <div class="wrap analyze__grid">
      <div>
        <p class="mono-label">Free, no obligation</p>
        <h2>{headings.home.statement}</h2>
        <p class="lede">{(site as any).home_statement.body}</p>
        <div class="actions">
          <a class="btn btn--primary" href="/contact">Upload a statement</a>
        </div>
      </div>
      <StatementAnalyzer />
    </div>
  </section>

  <BatchLine bare />

  <!-- WHY -->
  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Why merchants switch</p>
      <h2>{headings.home.perks}</h2>
      <div class="grid grid--2">
        {site.value_props.map((vp) => (
          <article class="card reveal">
            <h3>{vp.title}</h3>
            <p>{vp.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Social proof. Testimonials.astro renders nothing until there are three
      real entries in content/testimonials.json, which still ships empty — so
      this is a no-op today and switches itself on when Matt adds quotes. */}
  <Testimonials />

  <HomePromos />

  <!-- CLOSING — short contact form, so a visitor who got this far can reach
       us without leaving the page. Copy lives in site.json > home_contact. -->
  <section class="band band--dark cta">
    <div class="wrap cta__grid">
      <div>
        <p class="mono-label">{hc.eyebrow}</p>
        <h2>{headings.home.demo}</h2>
        <p class="lede">{hc.body}</p>
        <p class="cta__alt">
          {hc.alt_prefix} <a href={site.cta.primary.href}>{hc.alt_link}</a>
        </p>
      </div>
      <LeadForm name={enquiry.form_name} submitLabel={hc.submit_label} compact withEmail
        reason="demo" source={`Homepage — ${hc.submit_label}`} />
    </div>
  </section>
</Base>

<style>
  /* Five cards now: four hardware products plus EPAY Terminal. auto-fit keeps
     them even instead of leaving one stranded on a second row. */
  .prods { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .showcase__int { font-size: var(--small); color: var(--accent-deep); }

  /* Tightened so the two pricing cards sit closer to the fold. */
  /* Top padding halved (2026-09-18) to bring the title up under the menu. */
  .hero {
    padding-block: clamp(1.5rem, 3.5vw, 2.75rem) clamp(1.25rem, 2.5vw, 2rem);
  }

  /* 15ch was tuned for Bricolage Grotesque. Source Sans Pro is wider, and at
     15ch the tagline broke to three lines with "Designed / for Growth."
     Recheck this once the real Effra files land — Effra is narrower again. */
  .hero h1 { max-width: 18ch; }

  /* Title left, station picture right; stacks on narrow screens. */
  .hero__grid { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: 1.1fr 0.9fr; gap: 3rem; } }
  .hero__art { width: min(100%, 520px); justify-self: center; }


  .batchwrap { padding-bottom: clamp(1.25rem, 2.5vw, 2rem); background: var(--canvas); }

  .path__figure {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    color: var(--accent-deep);
    margin: 0 0 0.35rem;
    line-height: 1;
  }

  .path--accent { border-color: var(--epay); }

  .analyze__grid { display: grid; gap: 2.5rem; }

  @media (min-width: 900px) {
    .analyze__grid { grid-template-columns: 1.1fr 1fr; align-items: center; }
  }

  .analyze__slot {
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius-lg);
    background: var(--canvas);
    padding: 2.5rem 1.75rem;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .analyze__note { color: var(--text-muted); font-size: var(--small); margin: 0; }

  .plans { align-items: stretch; }

  .plan { display: flex; flex-direction: column; }
  .plan--hl { border-color: var(--epay); }
  .plan__badge { color: var(--accent-deep); }
  .plan .price { font-size: 1.75rem; color: var(--text); margin: 0.25rem 0 0.5rem; }
  .plan__int { font-size: var(--small); color: var(--accent-deep); }
  .plan__for { font-size: var(--small); color: var(--text-muted); }

  .plan__list { margin-top: auto; padding-top: 1rem; }
  .plan__list li {
    font-size: var(--small);
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }

  .showcase { display: flex; flex-direction: column; }
  .showcase__body { font-size: var(--small); color: var(--text-muted); }
  .showcase__price { font-size: 1.25rem; color: var(--text); margin: auto 0 0.15rem; }

  /* The two cheaper routes, stated on the card. Most merchants never reach
     the pricing page, so the alternative to paying up front belongs here. */
  .showcase__alt {
    font-family: var(--font-data);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0 0 0.5rem;
  }

  .showcase__free {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.75rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--glass);
    font-family: var(--font-data);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-deep);
    align-self: start;
  }

  .showcase__free-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--epay);
    flex: 0 0 auto;
  }

  .prods__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }

  .tag {
    font-family: var(--font-data);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--text-muted);
  }

  .verts { display: grid; gap: 2.5rem; margin-top: 2rem; }

  @media (min-width: 780px) {
    .verts { grid-template-columns: 1fr 1fr; }
  }

  .vertlist li { border-top: 1px solid var(--rule); }

  .vertlist a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 0.9rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease), padding-left var(--dur-fast) var(--ease);
  }

  .vertlist a:hover {
    color: var(--text);
    padding-left: 0.4rem;
  }

  .vertlist span { color: var(--accent-deep); }

  .cta__grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .cta__grid { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .cta__alt { font-size: var(--small); color: var(--text-muted); margin-top: 1.25rem; }
  /* --accent-deep, not --epay: #00d0fa is 1.84:1 on white and the token is a
     fill colour only. Lighthouse flagged this link at 1.84:1. */
  .cta__alt a { color: var(--accent-deep); font-weight: var(--weight-ui); }
</style>

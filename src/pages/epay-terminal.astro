---
// EPAY Terminal — software, not a device.
//
// It runs on the EPAY Mini. This page must never give it a hardware price or
// a lease rate; those belong to the Mini, and the page links there for them.

import Base from "../layouts/Base.astro";
import BatchLine from "../components/BatchLine.astro";
import ImageSlot from "../components/ImageSlot.astro";
import TerminalDemo from "../components/TerminalDemo.astro";
import LeadForm from "../components/LeadForm.astro";
import terminal from "../../content/terminal.json";
import { site, products, pricing, money, planById, headings, enquiry, leaseMonthly } from "../lib/content";

const t = terminal as any;
const mini = (products as any[]).find((p) => p.id === t.runs_on.product_id);
const plan = planById("terminal");
const hw = (pricing as any).hardware;
const leaseRate = leaseMonthly(mini);
---

<Base title={`EPAY Terminal — keypad payments on the Mini | ${site.brand.name}`} description={t.meta_description}>
  <section class="band band--deck hero">
    <div class="wrap hero__grid">
      <div class="rise">
        <p class="mono-label">{t.eyebrow}</p>
        <h1>{t.heading}</h1>
        <p class="lede">{t.lede}</p>
        {plan && (
          <p class="tm__plan figure">
            {money(plan.price)}<span class="tm__int">/{plan.interval}</span>
            <span class="tm__planfor">{plan.best_for}</span>
          </p>
        )}
        <div class="actions">
          <a class="btn btn--primary" href={site.cta.primary.href}>{site.cta.primary.label}</a>
          <a class="btn btn--ghost" href="/pricing">See pricing</a>
        </div>
      </div>
      <ImageSlot name="EPAY Terminal" file={t.hero_image} ratio="4 / 3" />
    </div>
  </section>

  <BatchLine
    readouts={[
      { label: "Runs on", value: mini.name },
      { label: "Software", value: plan ? `${money(plan.price)}/mo` : "See pricing" },
      { label: "Funding", value: "Next-day" },
    ]}
  />

  <!-- HOW IT WORKS -->
  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">How it works</p>
      <h2>{headings.terminal.steps}</h2>
      <ol class="tm__steps">
        {t.steps.map((step: any, i: number) => (
          <li class="card reveal">
            <span class="tm__num figure">{i + 1}</span>
            <h3>{step.name}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- TRY IT — a working copy of the Terminal screen -->
  <section class="band band--dark">
    <div class="wrap tm__demo">
      <div>
        <p class="mono-label">{t.demo.eyebrow}</p>
        <h2>{headings.terminal.demo}</h2>
        <p class="lede">{t.demo.body}</p>
        <p class="tm__note">{t.demo.note}</p>
      </div>
      <TerminalDemo />
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap tm__runs">
      <div>
        <p class="mono-label">No extra hardware</p>
        <h2>{t.runs_on.heading}</h2>
        <p class="lede">{t.runs_on.body}</p>
        <p class="tm__hw">
          {mini.name} — {mini.purchase_price ? money(mini.purchase_price) : "Ask us"}
          {" · "}lease {money(leaseRate)}/mo{" · "}or free with placement
        </p>
        <div class="actions">
          <a class="btn btn--ghost" href={`/product/${mini.id}`}>See the {mini.name}</a>
        </div>
      </div>
      <ImageSlot name={mini.name} file={t.runs_on.image ?? mini.image} ratio="4 / 3" />
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">What it does</p>
      <h2>{headings.terminal.does}</h2>
      <div class="grid grid--3 tm__points">
        {t.points.map((p: any) => (
          <article class="card reveal">
            <h3>{p.name}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- TERMINAL vs FULL POS -->
  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Is it the right fit</p>
      <h2>{headings.terminal.fit}</h2>
      <div class="tm__table-wrap">
        <table class="tm__table">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Feature</span></th>
              {t.compare.columns.map((c: string) => <th scope="col">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {t.compare.rows.map((row: any) => (
              <tr>
                <th scope="row">{row.name}</th>
                <td class={row.terminal ? "yes" : "no"}>{row.terminal ? "✓" : "—"}<span class="visually-hidden">{row.terminal ? "Included" : "Not included"}</span></td>
                <td class={row.full ? "yes" : "no"}>{row.full ? "✓" : "—"}<span class="visually-hidden">{row.full ? "Included" : "Not included"}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tm__foot">{t.compare.footnote}</p>

      <h3 class="tm__goodh">{headings.terminal.good_fit}</h3>
      <ul class="tm__good">
        {t.good_for.map((x: string) => <li class="tag">{x}</li>)}
      </ul>
      <div class="actions">
        <a class="btn btn--primary" href="/epay-products-1#build">Price a full system</a>
        <a class="btn btn--ghost" href="/epay-software">All EPAY Software</a>
      </div>
    </div>
  </section>

  <!-- CLOSING — short form, same as the homepage -->
  <section class="band band--dark">
    <div class="wrap tm__close">
      <div>
        <p class="mono-label">{t.closing.eyebrow}</p>
        <h2>{headings.terminal.closing}</h2>
        <p class="lede">{t.closing.body}</p>
      </div>
      <LeadForm name={enquiry.form_name} submitLabel={t.closing.submit_label} compact
        reason="equipment" source="EPAY Terminal page" />
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .hero__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: 1.1fr 1fr; } }

  .tm__plan { font-size: 1.75rem; color: var(--text); margin: 1.25rem 0 0; }
  .tm__int { font-size: var(--small); color: var(--accent-deep); }
  .tm__planfor { display: block; font-family: var(--font-body); font-size: var(--small); color: var(--text-muted); }

  .tm__runs { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .tm__runs { grid-template-columns: 1fr 1.15fr; } }
  .tm__hw { font-family: var(--font-data); font-size: var(--small); color: var(--text-muted); }

  .tm__points { margin-top: 2rem; }
  .tm__points p { color: var(--text-muted); font-size: var(--small); }

  .tm__steps { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem; }
  @media (min-width: 800px) { .tm__steps { grid-template-columns: repeat(3, 1fr); } }
  .tm__steps p { color: var(--text-muted); font-size: var(--small); margin: 0; }
  .tm__num { display: block; font-size: 1.5rem; color: var(--accent-deep); margin-bottom: 0.25rem; }

  /* Top-aligned: the device column is tall, and centring pushed the
     heading into the middle of the section, away from the copy above. */
  .tm__demo { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) {
    .tm__demo { grid-template-columns: 1fr 1fr; }
    /* Sits a little above the middle of the device rather than level with
       its top — centred looked adrift, top-aligned looked detached. */
    .tm__demo > div:first-child { padding-top: clamp(3rem, 16vh, 9rem); }
  }
  .tm__note { font-family: var(--font-data); font-size: var(--mono-label); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--text-muted); }

  .tm__table-wrap { overflow-x: auto; margin-top: 2rem; }
  .tm__table { width: 100%; min-width: 460px; border-collapse: collapse; background: var(--canvas); }
  .tm__table th, .tm__table td { padding: 0.8rem 1rem; border-bottom: 1px solid var(--rule); text-align: left; font-size: var(--small); }
  .tm__table thead th { font-family: var(--font-data); font-size: var(--mono-label); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--text-muted); font-weight: 400; }
  .tm__table tbody th { font-weight: var(--weight-ui); color: var(--text); }
  .tm__table td { width: 22%; font-family: var(--font-data); }
  .tm__table td.yes { color: var(--accent-deep); }
  .tm__table td.no { color: var(--text-muted); }
  .tm__foot { font-size: var(--small); color: var(--text-muted); margin-top: 1rem; }

  .tm__goodh { margin-top: 2.5rem; font-size: var(--heading); }
  .tm__good { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1rem 0 0; }

  .tm__close { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .tm__close { grid-template-columns: 1fr 1fr; gap: 4rem; } }
</style>

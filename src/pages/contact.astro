---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { site, enquiry, faqSchema } from "../lib/content";

const copy = (site as any).page_copy.contact;
const pageFaqSchema = faqSchema(copy.faqs);
---

<Base
  title={`Contact EPAY POS | Troy, MI`}
  description="Talk to the EPAY POS team about point of sale and processing, or send a recent statement for a free line-by-line review."
  schema={pageFaqSchema ?? undefined}
>
  <section class="band band--deck">
    <div class="wrap grid2">
      <div>
        <p class="mono-label">Contact</p>
        <h1>{copy.h1}</h1>
        <p class="lede">{copy.lede}</p>
        <address class="info">
          <p>{site.contact.address}</p>
          <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
          <p class="figure">Sales {site.contact.phone} ext. {site.contact.sales_ext}</p>
          <p class="figure">Support {site.contact.phone} ext. {site.contact.support_ext}</p>
        </address>
      </div>
      <LeadForm name={enquiry.form_name} submitLabel="Send message" withUpload
        source="Contact page" reason="other" />
    </div>
  </section>

  <FaqBlock faqs={copy.faqs} band="surface" moreLabel="All pricing and FAQs" />
</Base>

<style>
  .band { padding-block: clamp(4rem, 9vw, 7rem); }
  .grid2 { display: grid; gap: 3rem; }
  @media (min-width: 900px) { .grid2 { grid-template-columns: 1fr 1fr; } }
  .info { font-style: normal; margin-top: 2rem; color: var(--text-muted); }
  .info p { margin-bottom: 0.35rem; }
  .info a:hover { color: var(--accent-deep); }
</style>

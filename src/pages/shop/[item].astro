---
// One shop item, on its own page.
//
// Built from content/store.json — one page per item, no page file per item.
// While store.json > item_page.buy.enabled is false, every item shows the
// "Ask us" form. Turn that on and give an item a `buy_url` and the same page
// shows a Buy button instead.

import Base from "../../layouts/Base.astro";
import ImageSlot from "../../components/ImageSlot.astro";
import LeadForm from "../../components/LeadForm.astro";
import storeData from "../../../content/store.json";
import { site, money, enquiry } from "../../lib/content";

export function getStaticPaths() {
  const { items } = storeData as any;
  return (items as any[]).map((item) => ({ params: { item: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: any };
const s = storeData as any;
const ip = s.item_page;
const category = (s.categories as any[]).find((c: any) => c.id === item.category);
const related = (s.items as any[]).filter((i: any) => i.category === item.category && i.id !== item.id).slice(0, 4);
const canBuy = Boolean(ip.buy.enabled && item.buy_url);
const url = new URL(`/shop/${item.id}`, site.brand.domain).href;

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: item.name,
  description: item.meta_description,
  category: category?.name,
  brand: { "@type": "Brand", name: site.brand.name },
  ...(item.image ? { image: new URL(item.image, site.brand.domain).href } : {}),
  ...(item.price !== null
    ? {
        offers: {
          "@type": "Offer",
          price: item.price,
          priceCurrency: "USD",
          url,
          availability: "https://schema.org/InStock",
        },
      }
    : {}),
};
---

<Base
  title={`${item.name} | ${site.brand.name}`}
  description={item.meta_description}
  crumbs={[
    { name: "Home", href: "/" },
    { name: s.page.heading, href: "/shop" },
    { name: item.name, href: `/shop/${item.id}` },
  ]}
  schema={schema}
>
  <section class="band band--deck hero">
    <div class="wrap item__grid">
      <div class="rise">
        <p class="mono-label">
          <a href="/shop">{s.page.heading}</a>{category ? ` · ${category.name}` : ""}
        </p>
        <h1>{item.name}</h1>
        {(item.spec || item.pack) && (
          <p class="lede">{[item.spec, item.pack].filter(Boolean).join(" · ")}</p>
        )}
        <p class="item__price figure">
          {item.price !== null ? money(item.price) : "Ask us"}
          {item.price !== null && <span class="item__tax">plus tax</span>}
        </p>
        <div class="actions">
          {canBuy ? (
            <a class="btn btn--primary" href={item.buy_url}>{ip.buy.label}</a>
          ) : (
            <a class="btn btn--primary" href="#ask">{ip.ask_label}</a>
          )}
          <a class="btn btn--ghost" href="/shop">{ip.back_label}</a>
        </div>
        <p class="item__note">{ip.ships_note}</p>
      </div>
      <div class="item__media">
        <ImageSlot name={item.name} file={item.image} ratio="1 / 1" />
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap item__facts">
      <dl>
        {category && (<><dt>Category</dt><dd>{category.name}</dd></>)}
        {item.spec && (<><dt>Size</dt><dd>{item.spec}</dd></>)}
        {item.pack && (<><dt>Pack</dt><dd>{item.pack}</dd></>)}
        <dt>Price</dt>
        <dd>{item.price !== null ? `${money(item.price)} plus tax` : "Ask us for a quote"}</dd>
        {item.in_builder && (
          <><dt>System builder</dt><dd><a href="/epay-products-1#build">Add it while pricing a system</a></dd></>
        )}
      </dl>
      {!canBuy && <p class="item__buynote">{ip.buy.note}</p>}
    </div>
  </section>

  <section class="band band--dark ask" id="ask">
    <div class="wrap ask__grid">
      <div>
        <p class="mono-label">{ip.ask_eyebrow}</p>
        <h2>{ip.ask_heading}</h2>
        <p class="lede">{ip.ask_body}</p>
      </div>
      <LeadForm
        name={enquiry.form_name}
        submitLabel={ip.submit_label}
        compact
        reason="shop"
        source={`Shop item page — ${item.name}`}
        hiddenFields={{ item: `shop:${item.id}`, item_name: item.name }}
      />
    </div>
  </section>

  {related.length > 0 && (
    <section class="band band--dark">
      <div class="wrap">
        <p class="mono-label">{category?.name}</p>
        <h2>{ip.related_heading}</h2>
        <ul class="rel">
          {related.map((r: any) => (
            <li>
              <article class="card card--link rel__card"
                 data-enquire-reason="shop"
                 data-enquire={`shop:${r.id}`}
                 data-enquire-label={`Related item — ${r.name}`}>
                <ImageSlot name={r.name} file={r.image} ratio="1 / 1" />
                <p class="rel__name">{r.name}</p>
                <p class="rel__price figure">{r.price !== null ? money(r.price) : "Ask us"}</p>
                <a class="card__details" href={`/shop/${r.id}`} data-enquire-keep>
                  Item details <span aria-hidden="true">→</span>
                </a>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .item__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .item__grid { grid-template-columns: 1.05fr 0.95fr; gap: 4rem; } }
  .item__media { width: min(100%, 420px); justify-self: center; }
  .hero .mono-label a { color: inherit; }

  .item__price { font-size: 2rem; color: var(--text); margin: 1.25rem 0 0; }
  .item__tax { font-family: var(--font-body); font-size: var(--small); color: var(--text-muted); margin-left: 0.5rem; }
  .item__note { font-size: var(--small); color: var(--text-muted); margin-top: 1rem; }

  .item__facts dl { display: grid; grid-template-columns: 10rem 1fr; gap: 0.75rem 1.5rem; margin: 0; max-width: 46rem; }
  .item__facts dt { font-family: var(--font-data); font-size: var(--mono-label); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--text-muted); }
  .item__facts dd { margin: 0; color: var(--text); }
  .item__buynote { margin-top: 1.5rem; font-size: var(--small); color: var(--text-muted); }

  .ask__grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .ask__grid { grid-template-columns: 1fr 1fr; gap: 4rem; } }

  .rel { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .rel__card { display: grid; gap: 0.35rem; height: 100%; align-content: start; }
  .rel__name { margin: 0; font-weight: var(--weight-ui); }
  .rel__price { margin: 0; color: var(--accent-deep); }
</style>

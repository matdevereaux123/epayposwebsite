---
// ONE file generates 11 industry pages + 7 feature pages.
// Adding a page means adding an object to content/industries.json or
// content/features.json — never creating a new file here.

import fs from "node:fs";
import path from "node:path";
import Base from "../layouts/Base.astro";
import BatchLine from "../components/BatchLine.astro";
import ImageSlot from "../components/ImageSlot.astro";
import {
  industries,
  featureCategories,
  planById,
  productById,
  featureCategoryById,
  products,
  money,
  pricing,
  site,
  faqs,
  headings,
  fill,
  capabilitiesFor,
  integrationsFor,
} from "../lib/content";

export function getStaticPaths() {
  const industryPaths = industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { kind: "industry" as const, industry },
  }));

  // Several feature categories share a page (e.g. /epay-base-features),
  // so group them before generating routes.
  const byPage = new Map<string, typeof featureCategories>();
  for (const cat of featureCategories) {
    const slug = cat.page.replace(/^\//, "");
    byPage.set(slug, [...(byPage.get(slug) ?? []), cat]);
  }

  const featurePaths = [...byPage.entries()].map(([slug, cats]) => ({
    params: { slug },
    props: { kind: "feature" as const, cats },
  }));

  return [...industryPaths, ...featurePaths];
}

const props = Astro.props as any;
const isIndustry = props.kind === "industry";

const industry = isIndustry ? props.industry : null;
const cats = !isIndustry ? props.cats : [];

// Feature pages prefer the lead category's own meta_title/meta_description
// from features.json. The fallback is the category `name`, which is an
// internal nav label — "Front of House" is what we call the section, not
// anything a merchant types into a search box.
const title = isIndustry
  ? industry.meta_title
  : cats[0].meta_title ?? `${cats[0].name} | ${site.brand.name}`;
const description = isIndustry
  ? industry.meta_description
  : cats[0].meta_description ??
    `${cats[0].name} tools built into every EPAY POS system. ${cats[0].items[0].body}`;

const plan = isIndustry ? planById(industry.recommended_plan) : null;
const relatedFeatures = isIndustry
  ? industry.feature_ids.map(featureCategoryById).filter(Boolean)
  : [];
const relatedProducts = isIndustry
  ? industry.product_ids.map(productById).filter(Boolean)
  : [];

// Other verticals in the same category — real internal linking, and it gives
// a merchant who landed on the wrong page somewhere to go.
const siblings = isIndustry
  ? industries.filter((i: any) => i.category === industry.category && i.slug !== industry.slug)
  : [];

// FAQs. An industry with its own `faqs` in industries.json shows those and
// gets FAQPage schema for them; they are written per-vertical and so are
// unique to the page. Anything without its own set falls back to the shared
// subset and gets NO schema — that was the original reasoning and it still
// holds: the same four Q&As marked up on eleven pages is duplicate structured
// data, which Google discards rather than rewards.
const ownFaqs = (isIndustry ? industry.faqs : cats[0]?.faqs) ?? null;
const shortFaqs = ownFaqs ?? faqs.slice(0, 4);
const faqSchema = ownFaqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: ownFaqs.map((f: any) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;

// Feature pages link to the other feature pages; industry pages to their
// siblings. Same section, two sources.
const featureSiblings = !isIndustry
  ? [...new Map(featureCategories.map((c: any) => [c.page, c])).values()].filter(
      (c: any) => c.page !== cats[0].page
    )
  : [];

// Feature pages show the whole hardware lineup — any of it runs these tools.
const allProducts = !isIndustry ? products : [];

const audience = isIndustry ? industry.category : "restaurant";
const caps = capabilitiesFor(audience as any);
const integs = integrationsFor(audience as any);

const heroImage = isIndustry ? industry.hero_image : cats[0].hero_image;
const gallery = isIndustry ? (industry.gallery ?? []) : [];

// The hero runs as a two-photo strip — like /convenience-gas on the live site —
// whenever a page has a real hero shot AND a real second shot. With only one
// photo (or none) it falls back to the single landscape slot, so nothing
// half-empty ever ships. ImageSlot does the same existence check for its own
// placeholder state; this one decides the layout before that.
const onDisk = (file?: string) => {
  if (!file) return false;
  try {
    return fs.existsSync(path.join(process.cwd(), "public", file.replace(/^\//, "")));
  } catch {
    return false;
  }
};

const stripShot = isIndustry ? gallery.find((shot: any) => onDisk(shot.file)) : null;
const useStrip = isIndustry && onDisk(heroImage) && Boolean(stripShot);

// Whatever the strip did not take, and only if the photo actually exists —
// empty "+" boxes on a live industry page read as a broken site, not a plan.
const galleryShots = isIndustry
  ? gallery.filter((shot: any) => shot !== stripShot && onDisk(shot.file))
  : [];

// Service pages are filed under retail, so they carry their own override.
const setupHeading = isIndustry
  ? industry.setup_heading ?? (headings.industry.setup as any)[industry.category]
  : "";
---

<Base title={title} description={description} schema={faqSchema ?? undefined}>
  {isIndustry && industry.coming_soon && (
    <p class="soon">
      <strong>Coming soon.</strong> We're building this out. Everything below is the plan —
      talk to us now and we'll tell you where it's up to.
    </p>
  )}

  <section class="band band--deck hero">
    <div class="wrap hero__grid">
      <div>
        <p class="mono-label">{isIndustry ? industry.name : "Features"}</p>
        <h1>{isIndustry ? industry.headline : cats[0].name}</h1>
        <p class="lede">
          {isIndustry ? industry.subhead : `Built into every EPAY POS system. No add-on pricing.`}
        </p>
        <div class="actions">
          <a class="btn btn--primary" href={site.cta.primary.href}>{site.cta.primary.label}</a>
          <a class="btn btn--ghost" href={site.cta.secondary.href}>{site.cta.secondary.label}</a>
        </div>
      </div>
      {useStrip ? (
        <div class="hero__strip">
          <div class="hero__shot hero__shot--high">
            <ImageSlot name={`${industry.name} hero`} file={heroImage} ratio="4 / 5" width={900} height={1125} />
          </div>
          <div class="hero__shot hero__shot--low">
            <ImageSlot name={stripShot.name} file={stripShot.file} ratio="4 / 5" width={900} height={1125} />
          </div>
        </div>
      ) : (
        <ImageSlot
          name={isIndustry ? `${industry.name} hero` : `${cats[0].name} hero`}
          file={heroImage}
          ratio="4 / 3"
        />
      )}
    </div>
  </section>

  <BatchLine
    readouts={[
      { label: "Flat rate", value: pricing.processing.flat_rate.display },
      { label: "Or", value: `${pricing.processing.cash_discount.display} with cash discount` },
      { label: "Funding", value: "Next day" },
    ]}
  />

  {isIndustry && (
    <section class="band band--dark">
      <div class="wrap">
        <p class="mono-label">{headings.industry.solution_eyebrow}</p>
        <h2>{headings.industry.solution}</h2>
        <div class="pairs">
          <!-- Column labels for sighted desktop users. Screen readers get the
               per-row tags instead, so this row is hidden from them. -->
          <div class="pairs__head" aria-hidden="true">
            <p class="mono-label">{headings.industry.problem_label}</p>
            <span></span>
            <p class="mono-label">{headings.industry.solution_label}</p>
          </div>
          {industry.pain_points.map((point: any) => (
            <article class="pair reveal">
              <p class="pair__problem">
                <span class="pair__tag">{headings.industry.problem_label}</span>
                {point.problem}
              </p>
              <svg class="pair__arrow" viewBox="0 0 48 12" width="48" height="12" aria-hidden="true" focusable="false"><path class="pair__shaft" d="M1 6h42" /><path class="pair__head" d="M37.5 1.5 43.5 6l-6 4.5" /></svg>
              <p class="pair__solution">
                <span class="pair__tag">{headings.industry.solution_label}</span>
                {point.solution}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band band--light">
    <div class="wrap">
      <p class="mono-label">{isIndustry ? "Included" : "What's included"}</p>
      <h2>{isIndustry ? fill(headings.industry.built_for, { name: industry.name }) : headings.feature.all}</h2>
      <div class="grid grid--2 features">
        {(isIndustry ? relatedFeatures : cats).map((cat: any) => (
          <div class="card reveal">
            <h3>{cat.name}</h3>
            <ul class="featlist">
              {cat.items.map((item: any) => (
                <li>
                  <strong>{item.name}</strong>
                  <span>{item.body}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {isIndustry && plan && (
    <section class="band band--dark">
      <div class="wrap plan">
        <div>
          <p class="mono-label">Recommended plan</p>
          <h2>{plan.name}</h2>
          <p class="lede">{plan.best_for}</p>
          <p class="price">
            {money(plan.price)}<span class="price__int">/{plan.interval}</span>
          </p>
          <p class="rate">
            {pricing.processing.flat_rate.display} processing · or {pricing.processing.cash_discount.display} with cash discount
          </p>
          <div class="actions">
            <a class="btn btn--primary" href="/pricing">Full pricing</a>
          </div>
        </div>
        <ul class="planlist">
          {plan.features.map((f: string) => <li>{f}</li>)}
        </ul>
      </div>
    </section>
  )}

  {(isIndustry ? relatedProducts : allProducts).length > 0 && (
    <section class="band band--surface">
      <div class="wrap">
        <p class="mono-label">Hardware</p>
        <h2>{isIndustry ? setupHeading : headings.feature.hardware}</h2>
        <div class="grid grid--3">
          {(isIndustry ? relatedProducts : allProducts).map((product: any) => (
            <article class="card reveal prodcard"
                     data-enquire-reason="equipment"
                     data-enquire={`product:${product.id}`}
                     data-enquire-label={`${isIndustry ? industry.name : cats[0].name} hardware — ${product.name}`}>
              <ImageSlot name={product.name} file={product.image} ratio="4 / 3" />
              <p class="mono-label">{product.kicker}</p>
              <h3>{product.name}</h3>
              <p>{product.summary}</p>
              <ul class="prodcard__specs">
                {product.specs.map((spec: string) => <li>{spec}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {isIndustry && industry.systems && (
    <section class="band band--dark">
      <div class="wrap">
        <p class="mono-label">The setup</p>
        <h2>{headings.industry.systems}</h2>
        <div class="grid grid--3 systems">
          {industry.systems.map((sys: any) => (
            <article class="card reveal">
              <h3>{sys.name}</h3>
              <p>{sys.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Built in</p>
      <h2>{headings.industry.capabilities}</h2>
      <div class="caps">
        {caps.map((cap: any) => (
          <article class="cap reveal">
            <h3>{cap.name}</h3>
            <p>{cap.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Integrations</p>
      <h2>{headings.shared.integrations}</h2>
      <div class="grid grid--3">
        {integs.map((integ: any) => (
          <article class="card reveal">
            <p class="mono-label">{integ.kicker}</p>
            <h3>{integ.name}</h3>
            <p>{integ.body}</p>
            <ul class="integ__points">
              {integ.points.map((pt: string) => <li>{pt}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  {isIndustry && galleryShots.length > 0 && (
    <section class="band band--dark">
      <div class="wrap">
        <p class="mono-label">On site</p>
        <h2>{fill(headings.industry.gallery, { name: industry.name })}</h2>
        <div class="grid grid--3 gallery">
          {galleryShots.map((shot: any) => (
            <ImageSlot name={shot.name} file={shot.file} ratio="4 / 3" />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Included with every plan</p>
      <h2>{headings.shared.included}</h2>
      <ul class="incl">
        {pricing.included_with_every_plan.map((item: string) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Questions</p>
      <h2>{headings.shared.faq}</h2>
      <div class="faqs">
        {shortFaqs.map((faq: any) => (
          <details class="faq">
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
      <div class="actions">
        <a class="btn btn--ghost" href="/pricing">{ownFaqs ? "Pricing and more FAQs" : "All pricing and FAQs"}</a>
      </div>
    </div>
  </section>

  {isIndustry && siblings.length > 0 && (
    <section class="band band--dark">
      <div class="wrap">
        <p class="mono-label">Also in {industry.category}</p>
        <h2>{headings.industry.siblings}</h2>
        <ul class="siblings">
          {siblings.map((sib: any) => (
            <li><a href={`/${sib.slug}`}>{sib.name}<span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {!isIndustry && featureSiblings.length > 0 && (
    <section class="band band--dark">
      <div class="wrap">
        <p class="mono-label">More features</p>
        <h2>{headings.feature.siblings}</h2>
        <ul class="siblings">
          {featureSiblings.map((cat: any) => (
            <li><a href={cat.page}>{cat.name}<span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="band band--dark cta">
    <div class="wrap">
      <h2>{headings.industry.demo}</h2>
      <p class="lede">
        A short demo with someone who knows your business type. No pressure, no script.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href={site.cta.primary.href}>{site.cta.primary.label}</a>
        <a class="btn btn--ghost" href="/contact">Send us a statement</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(4rem, 10vw, 8rem) clamp(2.5rem, 5vw, 4rem); }
  .hero h1 { max-width: 20ch; }

  .pairs { margin-top: 2.5rem; }

  /* Problem -> arrow -> solution. One arrow per row so each problem points
     at its own answer. Stacked on narrow screens, arrow turned downward. */
  .pair {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .pairs__head { display: none; }

  .pair__problem {
    margin: 0;
    color: var(--text-muted);
  }

  .pair__solution {
    margin: 0;
    color: var(--text);
    font-weight: var(--weight-ui);
  }

  /* Per-row label: visible when stacked, screen-reader only side by side. */
  .pair__tag {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-data);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }

  .pair__arrow {
    display: block;
    width: 36px;
    height: auto;
    overflow: visible;
    transform: rotate(90deg);
    transform-origin: center;
    margin: 0.35rem 0 0.35rem -6px;
    transition: translate var(--dur) var(--ease);
  }
  .pair__arrow path {
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* --glass-line (3.36:1) for the shaft, --accent-deep (5.2:1) for the head:
     both clear the 3:1 minimum for meaningful graphics. */
  .pair__shaft { stroke: var(--glass-line); }
  .pair__head { stroke: var(--accent-deep); }

  @media (min-width: 780px) {
    .pairs__head,
    .pair {
      grid-template-columns: 1fr 48px 1.2fr;
      column-gap: 1.75rem;
      align-items: center;
    }
    .pairs__head { display: grid; padding-bottom: 0.25rem; }
    .pairs__head .mono-label { margin: 0; }

    .pair__tag {
      position: absolute;
      width: 1px; height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .pair__arrow { width: 48px; transform: none; margin: 0; }
    .pair:hover .pair__arrow { translate: 4px 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pair__arrow { transition: none; }
    .pair:hover .pair__arrow { translate: none; }
  }

  .featlist li {
    padding-block: 0.75rem;
    border-top: 1px solid var(--rule);
  }

  .featlist li:first-child { border-top: 0; padding-top: 0; }
  .featlist strong { display: block; font-weight: 600; }
  .featlist span { font-size: var(--small); color: var(--text-muted); }

  .plan { display: grid; gap: 2.5rem; }

  @media (min-width: 780px) {
    .plan { grid-template-columns: 1fr 1fr; align-items: start; }
  }

  .price { font-size: var(--display-lg); margin: 1rem 0 0.25rem; color: var(--text); }
  .price__int { font-size: var(--small); color: var(--accent-deep); }
  .rate { font-size: var(--small); color: var(--accent-deep); }

  .planlist li {
    padding-block: 0.85rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }

  .soon {
    margin: 0;
    padding: 0.7rem var(--gutter);
    background: var(--epay);
    color: var(--text);
    text-align: center;
    font-size: var(--small);
  }
  .soon strong { font-weight: 700; }

  .hero__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: 1.1fr 1fr; } }

  /* Two tall photos side by side, the right one dropped a little so the pair
     reads as a strip rather than a pair of tiles. */
  .hero__strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    align-items: start;
  }
  /* The stagger lives on these wrappers, not on the <img>. The image comes
     from ImageSlot, so it carries that component's scope and a rule written
     here would never match it. */
  .hero__shot--high { margin-top: 0; }
  .hero__shot--low { margin-top: clamp(2rem, 6vw, 5rem); }
  /* Shallower on the phone, but never flat — the pair should always read as
     a strip, not a two-up grid. */
  @media (max-width: 520px) {
    .hero__shot--low { margin-top: 1.5rem; }
  }

  .prodcard__specs { margin-top: 1rem; }
  .prodcard__specs li {
    font-size: var(--small);
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }

  .gallery { margin-top: 2rem; }
  .systems { margin-top: 2rem; }

  .caps {
    display: grid;
    gap: 1.25rem 2.5rem;
    margin-top: 2rem;
  }
  @media (min-width: 760px) { .caps { grid-template-columns: 1fr 1fr; } }

  .cap { padding-block: 1rem; border-top: 1px solid var(--rule); }
  .cap h3 { margin-bottom: 0.35rem; }
  .cap p { color: var(--text-muted); font-size: var(--small); margin: 0; }

  .integ__points { margin-top: 1rem; }
  .integ__points li {
    font-size: var(--small);
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }

  .incl { display: grid; gap: 0.25rem; margin-top: 1.5rem; }
  @media (min-width: 700px) { .incl { grid-template-columns: 1fr 1fr; } }
  .incl li { padding-block: 0.75rem; border-top: 1px solid var(--rule); }

  .faqs { margin-top: 1.5rem; max-width: 760px; }
  .faq { border-top: 1px solid var(--rule); }
  .faq summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem;
    padding: 1.1rem 0.85rem; margin-inline: -0.85rem;
    border-radius: var(--radius); cursor: pointer;
    font-family: var(--font-display); font-weight: 700; font-size: 1.0625rem;
    list-style: none;
    transition: background var(--dur-fast) var(--ease);
  }
  .faq summary:hover { background: var(--glass); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: "+"; flex-shrink: 0; font-family: var(--font-data);
    font-size: 1.25rem; line-height: 1; color: var(--accent-deep);
    transition: transform var(--dur) var(--ease);
  }
  .faq[open] summary::after { transform: rotate(135deg); }
  .faq p { color: var(--text-muted); padding-bottom: 1rem; max-width: 68ch; }

  .siblings { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .siblings a {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--rule-strong); border-radius: 999px;
    font-size: var(--small); color: var(--text-muted);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .siblings a:hover { border-color: var(--epay); color: var(--text); }
  .siblings span { color: var(--accent-deep); }

  .cta { text-align: center; }
  .cta .lede { margin-inline: auto; }
  .cta .actions { justify-content: center; }
</style>

---
import Base from "../layouts/Base.astro";
import BatchLine from "../components/BatchLine.astro";
import ImageSlot from "../components/ImageSlot.astro";
import { site, stats, pricing, headings } from "../lib/content";

const a = (site as any).about;
---

<Base title={`About EPAY POS | Troy, MI`} description={a.meta_description ?? a.lede}>
  <section class="band band--deck hero">
    <div class="wrap hero__grid">
      <div>
        <p class="mono-label">{a.eyebrow}</p>
        <h1>{a.heading}</h1>
        <p class="lede">{a.lede}</p>
        <div class="actions">
          <a class="btn btn--primary" href={site.cta.primary.href}>{site.cta.primary.label}</a>
          <a class="btn btn--ghost" href="/contact">Talk to someone</a>
        </div>
      </div>
      <ImageSlot name="About EPAY POS" file={a.hero_image} ratio="4 / 3" />
    </div>
  </section>

  <BatchLine
    readouts={[
      { label: "Merchants", value: stats.merchants, suffix: "+" },
      { label: "Based in", value: "Troy, MI" },
      { label: "Support", value: stats.support },
    ]}
  />

  {a.story && (
    <section class="band band--dark">
      <div class="wrap narrow">
        <p class="mono-label">Our story</p>
        <p class="lede">{a.story}</p>
      </div>
    </section>
  )}

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">How we work</p>
      <h2>{headings.about.approach}</h2>
      <div class="grid grid--3">
        {a.points.map((pt: any) => (
          <article class="card reveal">
            <h3>{pt.title}</h3>
            <p>{pt.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Included with every plan</p>
      <h2>{headings.shared.included}</h2>
      <ul class="incl">
        {pricing.included_with_every_plan.map((item: string) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="band band--dark">
    <div class="wrap">
      <p class="mono-label">Find us</p>
      <h2>{headings.about.location}</h2>
      <address class="info">
        <p>{site.contact.address}</p>
        <p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        <p class="figure">Sales {site.contact.phone} ext. {site.contact.sales_ext}</p>
        <p class="figure">Support {site.contact.phone} ext. {site.contact.support_ext}</p>
      </address>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .hero__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .hero__grid { grid-template-columns: 1.1fr 1fr; } }
  .narrow { max-width: 68ch; }
  .incl { display: grid; gap: 0.25rem; margin-top: 1.5rem; }
  @media (min-width: 700px) { .incl { grid-template-columns: 1fr 1fr; } }
  .incl li { padding-block: 0.75rem; border-top: 1px solid var(--rule); }
  .info { font-style: normal; color: var(--text-muted); margin-top: 1rem; }
  .info p { margin-bottom: 0.35rem; }
</style>

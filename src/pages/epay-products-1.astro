---
import Base from "../layouts/Base.astro";
import BatchLine from "../components/BatchLine.astro";
import ProductCarousel from "../components/ProductCarousel.astro";
import SystemBuilder from "../components/SystemBuilder.astro";
import ImageSlot from "../components/ImageSlot.astro";
import storeData from "../../content/store.json";
import { products, site, pricing, headings } from "../lib/content";

const copy = (site as any).page_copy.products;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: products.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: { "@type": "Product", name: p.name, description: p.summary, brand: site.brand.name },
  })),
};
const shop = (storeData as any).page;
const shopCategories = (storeData as any).categories;
---

<Base
  title={`POS Hardware & Terminals | ${site.brand.name}`}
  description="EPAY POS hardware — handhelds, countertop stations, kitchen displays, and retail systems. Free placement available for qualifying merchants."
  schema={productSchema}
>
  <section class="band band--deck hero">
    <div class="wrap">
      <p class="mono-label">Hardware</p>
      <h1>{copy.h1}</h1>
      <p class="lede">{copy.lede}</p>
      <div class="actions">
        <a class="btn btn--primary" href={site.cta.primary.href}>{site.cta.primary.label}</a>
      </div>
    </div>
  </section>

  <BatchLine
    readouts={[
      { label: "Placement", value: "Free for qualifying merchants" },
      { label: "Install", value: "Included" },
      { label: "Training", value: "Included" },
    ]}
  />

  <section class="band band--dark">
    <div class="wrap prods">
      {products.map((product, i) => (
        <article id={product.id} class={`prod reveal ${i % 2 === 1 ? "prod--flip" : ""}`}>
          <div class="prod__media"
               data-enquire-reason="equipment"
               data-enquire={`product:${product.id}`}
               data-enquire-label={`Products page photo — ${product.name}`}>
            <ImageSlot name={product.name} file={product.image} ratio="4 / 3" />
          </div>
          <div class="prod__body">
            <p class="mono-label">{product.kicker}</p>
            <h2>{product.name}</h2>
            <p class="lede">{product.summary}</p>
            <p>{product.body}</p>
            <ul class="prod__specs">
              {product.specs.map((s) => <li>{s}</li>)}
            </ul>
            <ul class="prod__tags">
              {product.best_for.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <SystemBuilder />

  <!-- THE SHOP — the catalogue lives on its own page now, one page per item. -->
  <section class="band band--dark shopteaser" id="store">
    <div class="wrap shopteaser__grid">
      <div>
        <p class="mono-label">{shop.teaser.eyebrow}</p>
        <h2>{shop.teaser.heading}</h2>
        <p class="lede">{shop.teaser.body}</p>
        <div class="actions">
          <a class="btn btn--primary" href="/shop">{shop.teaser.cta}</a>
        </div>
      </div>
      <ul class="shopteaser__list">
        {shopCategories.map((c: any) => (
          <li><a href="/shop">{c.name}<span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <ProductCarousel />

  <section class="band band--surface">
    <div class="wrap">
      <p class="mono-label">Pricing</p>
      <h2>{headings.products.more}</h2>
      <p class="lede">
        Software runs from {pricing.plans[0].name.toLowerCase()} at a flat monthly rate, and
        processing is {pricing.processing.flat_rate.display} — or 0% on cash discount.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/pricing">See pricing</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(4rem, 10vw, 8rem) clamp(2.5rem, 5vw, 4rem); }
  .hero h1 { max-width: 20ch; }

  .prods { display: grid; gap: clamp(3rem, 6vw, 5rem); }

  .prod { display: grid; gap: 2rem; align-items: center; }

  @media (min-width: 860px) {
    .prod { grid-template-columns: 1fr 1fr; gap: 3.5rem; }
    .prod--flip .prod__media { order: 2; }
  }

  .prod__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--canvas);
    display: grid;
    place-items: center;
  }

  .prod__ph {
    font-family: var(--font-data);
    font-size: var(--mono-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .prod__specs { margin-top: 1.25rem; }
  .prod__specs li {
    font-size: var(--small);
    padding-block: 0.55rem;
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }

  .prod__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.25rem; }

  .tag {
    font-family: var(--font-data);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--text-muted);
  }
  .shopteaser__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .shopteaser__grid { grid-template-columns: 1.1fr 0.9fr; gap: 4rem; } }
  .shopteaser__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.1rem; }
  .shopteaser__list a { display: flex; justify-content: space-between; gap: 1rem; padding-block: 0.7rem; border-top: 1px solid var(--rule); color: var(--text); font-weight: var(--weight-ui); }
  .shopteaser__list a:hover { color: var(--accent-deep); }
  .shopteaser__list span { color: var(--accent-deep); }
</style>

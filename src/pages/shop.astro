---
// The Shop — the full catalogue on its own page.
//
// Everything here comes from content/store.json. Each card links to that
// item's own page at /shop/<id>.

import Base from "../layouts/Base.astro";
import BatchLine from "../components/BatchLine.astro";
import Store from "../components/Store.astro";
import LeadForm from "../components/LeadForm.astro";
import storeData from "../../content/store.json";
import { site, enquiry } from "../lib/content";

const s = storeData as any;
const page = s.page;
const priced = (s.items as any[]).filter((i: any) => i.price !== null).length;

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: page.heading,
  itemListElement: (s.items as any[]).map((item: any, i: number) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.name,
    url: new URL(`/shop/${item.id}`, site.brand.domain).href,
  })),
};
---

<Base title={page.meta_title} description={page.meta_description} schema={schema}>
  <section class="band band--deck hero">
    <div class="wrap rise">
      <p class="mono-label">{page.eyebrow}</p>
      <h1>{page.heading}</h1>
      <p class="lede">{page.lede}</p>
      <div class="actions">
        <a class="btn btn--primary" href="/epay-products-1#build">Build a system</a>
        <a class="btn btn--ghost" href="/contact">Ask about an item</a>
      </div>
    </div>
  </section>

  <BatchLine
    readouts={[
      { label: "Items", value: s.items.length },
      { label: "Priced online", value: priced },
      { label: "Shipping", value: "With your system or on its own" },
    ]}
  />

  <Store showIntro={false} />

  <section class="band band--dark shop-cta">
    <div class="wrap shop-cta__grid">
      <div>
        <p class="mono-label">{s.item_page.ask_eyebrow}</p>
        <h2>{s.item_page.ask_heading}</h2>
        <p class="lede">{s.item_page.ask_body}</p>
      </div>
      <LeadForm name={enquiry.form_name} submitLabel={s.item_page.submit_label} compact
        reason="shop" source="The Shop page" />
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .shop-cta__grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .shop-cta__grid { grid-template-columns: 1fr 1fr; gap: 4rem; } }
</style>

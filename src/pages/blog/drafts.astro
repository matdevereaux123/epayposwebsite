---
// Local review page for blog drafts. Only lists anything when the preview is
// built with BLOG_SHOW_DRAFTS=1; on the live site it is empty and noindex.

import Base from "../../layouts/Base.astro";
import { draftPosts, showDrafts, readingMinutes, formatDate } from "../../lib/blog";

const drafts = showDrafts ? await draftPosts() : [];
---

<Base noindex title="Blog drafts | EPAY POS" description="Blog drafts waiting for review. Only visible in the local preview.">
  <section class="band band--deck">
    <div class="wrap">
      <p class="mono-label">Blog drafts</p>
      <h1>Waiting for Your OK</h1>
      <p class="lede">
        {showDrafts
          ? "Each post below was drafted by Claude and is not public. Read it, then tell Claude \"approve\" plus the title to publish it, or say what to change."
          : "Drafts are only shown in the local preview."}
      </p>
    </div>
  </section>

  {showDrafts && (
    <section class="band band--dark">
      <div class="wrap">
        {drafts.length === 0 ? (
          <p>No drafts waiting.</p>
        ) : (
          <ol class="dr-list">
            {drafts.map((p) => (
              <li>
                <a class="card card--link" href={`/blog/${p.id}`}>
                  <p class="mono-label">Drafted {formatDate(p.data.published)} · {readingMinutes(p)} min read · keyword: {p.data.keyword}</p>
                  <h2>{p.data.title}</h2>
                  <p>{p.data.description}</p>
                  <p class="dr-file">content/blog/{p.id}.md</p>
                </a>
              </li>
            ))}
          </ol>
        )}
      </div>
    </section>
  )}
</Base>

<style>
  .dr-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .dr-list h2 { font-size: var(--heading); margin: 0.25rem 0; }
  .dr-list p { color: var(--text-muted); font-size: var(--small); margin: 0; }
  .dr-file { font-family: var(--font-data); margin-top: 0.5rem !important; }
</style>

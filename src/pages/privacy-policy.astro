---
// Layout only. The body comes from site.json > legal.privacy.body, which is
// empty until real reviewed text is pasted in. This page will NOT invent
// legal wording — the project README says so explicitly, and legal text
// generated by a model is a liability, not a draft.
import Base from "../layouts/Base.astro";
import { site } from "../lib/content";

const doc = (site as any).legal.privacy;
const hasText = Array.isArray(doc.body) && doc.body.length > 0;
---

<Base
  title={`${doc.heading} | ${site.brand.name}`}
  description={doc.meta_description ?? `${doc.heading} for ${site.brand.name}.`}
>
  <section class="band band--deck legal">
    <div class="wrap narrow">
      <p class="mono-label">Legal</p>
      <h1>{doc.heading}</h1>
      {doc.updated && <p class="legal__updated figure">{doc.updated_label ?? "Last updated"} {doc.updated}</p>}

      {hasText ? (
        <div class="legal__body">
          {doc.body.map((block: any) =>
            block.t === "h" ? <h2>{block.x}</h2>
            : block.t === "li" ? <p class="legal__li">{block.x}</p>
            : <p>{block.x}</p>
          )}
        </div>
      ) : (
        <div class="legal__placeholder">
          <p class="legal__placeholder-title">This page is waiting on its text.</p>
          <p>
            Paste the reviewed {doc.heading.toLowerCase()} into
            <code>content/site.json</code> under <code>legal.privacy.body</code> as an
            array of paragraphs, and set <code>legal.privacy.updated</code> to the date.
            The layout below is ready for it.
          </p>
          <p class="legal__warn">
            This text must come from your counsel. Nothing here is generated.
          </p>
        </div>
      )}

      <p class="legal__contact">
        Questions about this document: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>,
        or {site.contact.phone}.
      </p>
    </div>
  </section>
</Base>

<style>
  .legal { padding-block: clamp(3.5rem, 8vw, 6rem); }
  .narrow { max-width: 72ch; }
  .legal p { color: var(--text-muted); }

  .legal__body h2 {
    font-size: var(--heading);
    margin: 2.25rem 0 0.6rem;
    color: var(--text);
  }
  .legal__body h2:first-child { margin-top: 0; }
  .legal__body p { margin-bottom: 1rem; }

  /* The Terms use a long bulleted list of prohibited uses. Rendered as
     indented paragraphs with a rule, so the list reads without inventing
     structure the source document does not have. */
  .legal__li {
    padding-left: 1.1rem;
    border-left: 2px solid var(--rule-strong);
    margin-bottom: 0.6rem;
  }
  .legal__updated { font-size: var(--small); color: var(--text-muted); margin-bottom: 2rem; }

  .legal__placeholder {
    border: 1px dashed var(--epay);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    margin-block: 1.5rem;
  }
  .legal__placeholder-title { font-weight: var(--weight-ui); color: var(--text); }
  .legal__placeholder code {
    font-family: var(--font-data); font-size: 0.8125rem;
    background: var(--glass); padding: 0.1rem 0.35rem; border-radius: var(--radius-sm);
  }
  .legal__warn { color: var(--accent-deep); font-weight: var(--weight-ui); margin-bottom: 0; }
  .legal__contact { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .legal__contact a { color: var(--accent-deep); }
</style>

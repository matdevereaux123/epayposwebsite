---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LeadMagnets from "../components/LeadMagnets.astro";
import EnquiryDialog from "../components/EnquiryDialog.astro";
import { site, partnerConfig } from "../lib/content";
import applicationData from "../../content/application.json";

const partnerCfg = partnerConfig();
// Supabase's publishable key — designed to sit in public pages; the only
// thing these pages may call is the insert-only lead and application functions.
const crm = {
  url: (applicationData as any).crm.url,
  key: (applicationData as any).crm.anon_key,
  lead_slug: (applicationData as any).crm.lead_slug || "",
};
import { googleFontsHref, fontVars } from "../lib/fonts";
import "../styles/global.css";

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD to merge in on specific pages (Product, FAQPage, etc.) */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** "article" for blog posts; everything else is a website page. */
  ogType?: "website" | "article";
  /** Blog posts: ISO dates for article:published_time / modified_time. */
  published?: string;
  modified?: string;
  /** Keep a page out of search results (thank-you, 404, drafts). */
  noindex?: boolean;
  /** Override the automatic breadcrumb trail (Home > Section > Page). */
  crumbs?: Crumb[];
  /** Hide the free-downloads row. The application page opts out: it is a
      form someone is filling in, not a page to be pulled away from. */
  noLeadMagnets?: boolean;
}

const { title, description, schema, ogType = "website", published, modified, noindex = false, crumbs, noLeadMagnets = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.brand.domain).href;

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.brand.name,
  url: site.brand.domain,
  email: site.contact.email,
  telephone: site.contact.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: "185 E Big Beaver Rd",
    addressLocality: "Troy",
    addressRegion: "MI",
    postalCode: "48083",
    addressCountry: "US",
  },
  logo: new URL(site.brand.logo, site.brand.domain).href,
  image: new URL(site.brand.share_image, site.brand.domain).href,
  sameAs: Object.values(site.social),
};
const shareImage = new URL(site.brand.share_image, Astro.site ?? site.brand.domain).href;

const extraSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

// Breadcrumbs for Google: built from the URL unless a page passes its own.
// Sections that have a landing page get a middle crumb.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const pageName = title.split(" | ")[0].split(" — ")[0];
const sectionFor: Record<string, Crumb> = {
  blog: { name: "Blog", href: "/blog" },
  product: { name: "Products", href: "/epay-products-1" },
};
const autoCrumbs: Crumb[] =
  path === "/"
    ? []
    : [
        { name: "Home", href: "/" },
        ...(path.split("/").length > 2 && sectionFor[path.split("/")[1]] ? [sectionFor[path.split("/")[1]]] : []),
        { name: pageName, href: path },
      ];
const trail = crumbs ?? autoCrumbs;
const breadcrumbSchema =
  trail.length > 1 && !noindex
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: trail.map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: c.name,
          item: new URL(c.href, site.brand.domain).href,
        })),
      }
    : null;

// The homepage also names the site itself, which helps Google show the
// brand name in results.
const websiteSchema =
  path === "/"
    ? { "@context": "https://schema.org", "@type": "WebSite", name: site.brand.name, url: site.brand.domain }
    : null;

// Typefaces come from src/lib/fonts.ts — the single place they're configured.
const fontsHref = googleFontsHref();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href={site.brand.icon_ico} sizes="32x32" />
    <link rel="icon" href={site.brand.icon} type="image/png" />
    <link rel="apple-touch-icon" href={site.brand.touch_icon} />

    <meta property="og:type" content={ogType} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.brand.name} blog`} href="/blog/rss.xml" />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.brand.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {fontsHref && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={fontsHref} />
      </>
    )}
    <style set:html={fontVars()} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {websiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    {extraSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
      {!noindex && !noLeadMagnets && <LeadMagnets />}
    </main>
    <EnquiryDialog />
    <Footer />

    <script>
      // Scroll reveal — one-time, respects reduced motion via the CSS above.
      const items = document.querySelectorAll(".reveal");
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry, i) => {
              if (entry.isIntersecting) {
                setTimeout(() => entry.target.classList.add("is-visible"), i * 60);
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px" }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-visible"));
      }
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--epay);
        color: #fff;
        padding: 0.75rem 1.25rem;
        z-index: 200;
      }
      .skip:focus {
        left: 0;
      }
    </style>
    <!-- REFERRAL ATTRIBUTION
         A partner sends people to epaypos.net/<their path>, which lands here
         carrying ?partner=<id>. The id is remembered for 30 days so a visitor
         who leaves and comes back is still credited, and the forms read it
         when they submit. Nothing about the page changes — same brand, same
         content; only where the lead lands. -->
    <script is:inline define:vars={{ partnerCfg, crm }}>
      (function () {
        var KEY = "epay-partner";
        function known(id) {
          for (var i = 0; i < partnerCfg.partners.length; i++) {
            if (partnerCfg.partners[i].id === id) return partnerCfg.partners[i];
          }
          return null;
        }
        function read() {
          try {
            var raw = localStorage.getItem(KEY);
            if (!raw) return null;
            var saved = JSON.parse(raw);
            var ageDays = (Date.now() - saved.at) / 86400000;
            if (ageDays > partnerCfg.days) { localStorage.removeItem(KEY); return null; }
            return known(saved.id);
          } catch (e) { return null; }
        }
        try {
          var fromUrl = new URLSearchParams(location.search).get(partnerCfg.param);
          var match = fromUrl && known(fromUrl);
          if (match) {
            try { localStorage.setItem(KEY, JSON.stringify({ id: match.id, at: Date.now() })); } catch (e) {}
            // Tidy the address bar so the tag is not passed around in shared links.
            var url = new URL(location.href);
            url.searchParams.delete(partnerCfg.param);
            history.replaceState({}, "", url.pathname + url.search + url.hash);
          }
        } catch (e) {}
        window.epayPartner = read;
        window.EPAY_CRM = crm;
      })();
    </script>
  </body>
</html>
